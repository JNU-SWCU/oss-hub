#!/usr/bin/env bash
# 커밋 메시지가 AGENTS.md §5(Conventional Commits + 이 repo의 type 8종)를 지키는지
# **커밋하는 그 순간** 검사한다.
#
# 왜 여기서 막나: 예전에는 commitlint 이 CI 에서만 돌았다. 그래서 규칙에 없는
# type 이 로컬에서 아무 저항 없이 커밋되고, PR 을 올린 뒤에야 빨간불로 드러났다.
# 그 시점에는 이미 이력에 박혀 있어 고치려면 역사를 다시 써야 하고, 그 커밋을
# 다른 브랜치가 가리키고 있으면 강제 푸시가 남의 작업을 무너뜨린다. 실제로
# `fdf9941`(`style` type)이 그렇게 들어와 PR 두 개를 오래 막았다. 커밋 시점에
# 막으면 고치는 비용이 "메시지 다시 쓰기" 한 번으로 끝난다.
#
# 우회: 부득이하면 `git commit --no-verify`. 다만 CI 의 commitlint 는 그대로
# 돌므로 우회해도 PR 에서 다시 걸린다 — 우회는 미루기지 통과가 아니다.
#
# 훅이 켜지려면 `git config core.hooksPath .githooks` 가 필요하다(pre-push·
# post-merge 와 같은 설정 하나를 공유한다). 상세: AGENTS.md §7

set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# commitlint 이 없는 환경(의존성 미설치 등)에서는 커밋을 막지 않는다.
# 검사를 못 하는 것과 검사에 실패한 것은 다르고, 전자로 작업을 세우면
# 훅을 통째로 꺼 버리는 쪽으로 사람이 움직인다.
if [ ! -x "$root/node_modules/.bin/commitlint" ]; then
  echo "commit-msg: commitlint 이 설치돼 있지 않아 건너뛴다 (pnpm install 후 다시 켜진다)" >&2
  exit 0
fi

exec "$root/node_modules/.bin/commitlint" \
  --config "$root/commitlint.config.cjs" \
  --edit "$1"
