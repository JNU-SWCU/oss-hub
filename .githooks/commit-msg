#!/usr/bin/env bash

set -euo pipefail

root="$(git rev-parse --show-toplevel)"

if [ ! -x "$root/node_modules/.bin/commitlint" ]; then
  echo "commit-msg: commitlint 이 설치돼 있지 않아 건너뛴다 (pnpm install 후 다시 켜진다)" >&2
  exit 0
fi

exec "$root/node_modules/.bin/commitlint" \
  --config "$root/commitlint.config.cjs" \
  --edit "$1"
