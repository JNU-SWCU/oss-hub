{
  "extends": "../apps/frontend/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "../apps/frontend/ds-types",
    "rootDir": "../apps/frontend/src",
    "jsx": "react-jsx",
    "incremental": false,
    "baseUrl": "../apps/frontend",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "../apps/frontend/src/components/**/*.ts",
    "../apps/frontend/src/components/**/*.tsx",
    "../apps/frontend/src/lib/**/*.ts"
  ],
  "exclude": [
    "../apps/frontend/**/*.test.ts",
    "../apps/frontend/**/*.test.tsx",
    "../apps/frontend/src/lib/server-api-client.ts"
  ]
}
