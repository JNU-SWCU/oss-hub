{
  "extraKnownMarketplaces": {
    "craft-skills": {
      "source": { "source": "github", "repo": "GoBeromsu/craft-skills" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": { "craft-skills@craft-skills": true },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/check-pr-body.sh --hook"
          }
        ]
      }
    ]
  }
}
