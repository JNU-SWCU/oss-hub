# 운영 환경값은 배포 서버의 .env에서만 관리합니다.
# 개발 PostgreSQL 값은 compose.dev.yml에 인라인으로 정의하며, 마이그레이션 연결 문자열은 backend 패키지 스크립트가 주입합니다.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# 제출 파일 S3 호환 저장소.
# endpoint·region·bucket·force_path_style은 compose.yml MinIO 토폴로지 기본값을 쓴다(비우면 그 기본값).
# 로컬 compose 경로 엔드포인트는 http://minio:9000 이다(docs/rules/local-dev.md).
SUBMISSION_FILE_S3_ENDPOINT=
SUBMISSION_FILE_S3_REGION=
SUBMISSION_FILE_S3_BUCKET=
SUBMISSION_FILE_S3_ACCESS_KEY_ID=oss-hub-local
SUBMISSION_FILE_S3_SECRET_ACCESS_KEY=oss-hub-local-synthetic-secret
SUBMISSION_FILE_S3_FORCE_PATH_STYLE=

# GitHub OAuth 로그인 (backend). 운영은 client ID/secret이 필수이며 callback은 FRONTEND_URL에서 파생합니다.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 선택 호환값. 설정하면 FRONTEND_URL과 같은 origin의 /api/v1/auth/github/callback이어야 합니다.
GITHUB_OAUTH_CALLBACK_URL=

# GitHub Collection App REST-only 수집 (#151, ADR-006 C2). installation은 조직 login으로 조회하며 private key는 배포 secret store에만 둡니다.
GITHUB_APP_ORG=
GITHUB_COLLECTION_APP_ID=
GITHUB_COLLECTION_APP_PRIVATE_KEY=
# 권장 입력: 키 값이 아니라 PEM 파일 경로입니다. 이 값이 있으면 위 문자열 키는 무시합니다.
# 파일을 읽거나 파싱하지 못하면 문자열 키로 되돌아가지 않고 기동에 실패합니다.
# 로컬은 추적하지 않는 secrets/ 아래에 사람이 배치하고, 운영은 Jenkins가 안정 경로에 설치합니다.
GITHUB_COLLECTION_APP_PRIVATE_KEY_FILE=
# 선택값: 기본 https://api.github.com, 최대 100 pages / 30000ms보다 낮게만 설정할 수 있습니다.
GITHUB_COLLECTION_APP_API_BASE_URL=
GITHUB_COLLECTION_APP_MAX_PAGES=
GITHUB_COLLECTION_APP_DEADLINE_MS=
# Live smoke aliases use public-safe-label=repository-name. The private fixture is required when running the smoke command.
GITHUB_COLLECTION_APP_SMOKE_PUBLIC_ALIASES=
GITHUB_COLLECTION_APP_SMOKE_PRIVATE_ALIAS=

# GitHub Repository Operations App (#121). private key는 배포 secret store에만 둡니다.
GITHUB_OPERATIONS_APP_ID=
GITHUB_OPERATIONS_APP_PRIVATE_KEY=
# 권장 입력: 키 값이 아니라 PEM 파일 경로입니다. 규칙은 위 Collection App과 같습니다.
GITHUB_OPERATIONS_APP_PRIVATE_KEY_FILE=

# 수집 스케줄 cron (초 포함 6필드). 기본값 0 0 * * * * (매시 정각).
COLLECTION_CRON_EXPRESSION=
# backend listen 포트. 기본값 4000.
PORT=

# 세션 서명 키 — base64url 32바이트 이상. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# 로그인 후 redirect 대상이자 허용 Origin. 개발 기본값 http://localhost:3000
FRONTEND_URL=

# 초기 역할 시드 — 형식 "githubId:ROLE" 쉼표 구분이며 ROLE은 ADMIN|STAFF|STUDENT만 허용한다.
# 기존 role은 덮어쓰지 않으며, 형식 오류가 있으면 기동이 실패하고 dev·운영에서 동일하게 동작한다.
AUTH_INITIAL_ROLES=

# 팀 참여코드 HMAC-SHA-256 digest 키 (#164) — Team에는 평문 대신 digest만 저장한다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 환경과 무관하게 미설정·빈 값이면 즉시 실패한다. 로컬 `.env`에는 실데이터와 무관한 합성 키를 생성해 넣는다.
TEAM_JOIN_CODE_SECRET=

# #127 마감 알림 메일 발송. MAIL_MODE는 exact send|dry-run만 허용한다.
# 이 파일은 로컬 예시이므로 dry-run(로그 전용)을 둔다. 운영 배포 secret file은 MAIL_MODE=send 와 GMAIL_* 4종을 함께 요구한다.
# 실 Gmail 값은 배포 secret store의 Jenkins file credential에만 둔다(사람 배포 전제; 이 저장소에 값을 두지 않는다).
MAIL_MODE=dry-run
GMAIL_SENDER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# 제출 파일 cleanup 유지보수 CLI 전용. 운영 컨테이너 기본 경로에서는 쓰지 않는다.
SUBMISSION_FILE_CLEANUP_MAINTENANCE_ENABLED=
SUBMISSION_FILE_CLEANUP_OPERATOR_ID=
