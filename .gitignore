# architecture-boundary.eslint.spec.ts 가 실제 모듈 폴더 안에 잠깐 썼다가 지우는
# lint fixture. glob(`src/<module>/**`)에 걸리려면 src 안에 있어야 하는데, 테스트가
# 중간에 죽으면 남아 tsc·lint·build 대상이 되고 실수로 커밋된다(실제로 한 번 그랬다).
# 항상 재생성되는 파일이므로 추적하지 않는다.
apps/backend/src/**/__lint_fixture_*.ts

# design-sync (claude.ai/design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
apps/frontend/.ds-css/
apps/frontend/ds-types/
apps/frontend/index.d.ts

# 검증 산출물 — 학생별 원시 수치(비공개 기여량 포함)가 들어가므로 공개 저장소에 넣지 않는다.
# PR 본문에도 집계 판정만 남긴다(ADR-010 §5).
/artifacts/
