---
import { Image } from 'astro:assets';
import '~/styles/tokens.css';
import SiteNote from '~/components/SiteNote.astro';
import { serviceUrl } from '~/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/shots/landing/*.webp',
  { eager: true },
);
const shot = (name: string) => images[`/src/assets/shots/landing/${name}.webp`]?.default;

const hero = {
  name: 'hero',
  alt: '프로그램 목록과 신청 현황을 보여 주는 OSS Hub 화면',
};

const flow = [
  {
    name: 'explore',
    no: '01',
    title: '탐색',
    body: '프로그램의 신청 기간, 운영 일정과 제출 항목을 확인합니다.',
    alt: '프로그램의 신청 기간과 제출 항목을 보여 주는 화면',
  },
  {
    name: 'apply',
    no: '02',
    title: '준비·신청',
    body: '팀을 구성하고 필요한 신청 정보를 작성해 제출합니다.',
    alt: '팀원 초대와 신청 정보 작성 화면',
  },
  {
    name: 'decide',
    no: '03',
    title: '신청 판정',
    body: '교직원이 신청을 검토하고 승인 또는 반려합니다.',
    alt: '교직원이 신청을 승인하거나 반려하는 화면',
  },
  {
    name: 'submit',
    no: '04',
    title: '활동·제출·검토',
    body: '승인된 팀이 서류를 제출하고, 검토 결과에 따라 보완합니다. 신청 승인과 개별 제출물의 검토 결과는 별도로 관리합니다.',
    alt: '서류별 마감과 제출 상태를 보여 주는 화면',
  },
];

const roles = [
  {
    name: '관리자',
    href: `${base}/admin/`,
    body: '프로그램 운영 권한에 더해 사용자·권한, 감사 로그와 시스템을 관리합니다.',
  },
  {
    name: '학생',
    href: `${base}/student/`,
    body: '프로그램 신청, 팀 참여, 승인된 신청의 서류 제출·재제출, 본인 저장소·활동 확인을 합니다.',
  },
  {
    name: '교직원',
    href: `${base}/staff/`,
    body: '프로그램 운영, 신청 승인·반려, 제출물 검토와 보완 요청을 합니다.',
  },
];

const faq = [
  {
    q: '한 계정에 여러 권한이 있을 수 있나요?',
    a: '회원 유형과 운영 권한은 별도로 관리되며, 한 계정에 여러 권한이 부여될 수 있습니다.',
  },
  {
    q: '내가 참여한 팀의 신청을 판정할 수 있나요?',
    a: '교직원과 관리자 모두 자신이 참여한 팀의 신청을 판정하거나 제출물을 검토할 수 없습니다.',
  },
  {
    q: '신청이 승인되면 제출물도 승인된 것인가요?',
    a: '아닙니다. 신청 승인과 개별 제출물의 검토 결과는 별도로 관리합니다.',
  },
];

const nav = [
  ['서비스 소개', `${base}/intro/`],
  ['시작하기', `${base}/start/`],
  ['관리자', `${base}/admin/`],
  ['학생', `${base}/student/`],
  ['교직원', `${base}/staff/`],
  ['FAQ', `${base}/faq/`],
];
---

<!doctype html>
<html lang="ko" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OSS Hub 사용 가이드</title>
    <meta
      name="description"
      content="전남대학교 오픈소스 SW 개발 사업단 프로그램을 위한 OSS Hub의 역할별 사용 안내입니다."
    />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (() => {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch {}
        const dark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme =
          stored || (dark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href={`${base}/`}>
          <svg viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#003399"></rect>
            <circle cx="16" cy="16" r="7" fill="none" stroke="#fff" stroke-width="3.5"></circle>
            <circle cx="16" cy="16" r="2" fill="#2aab63"></circle>
          </svg>
          <span>OSS Hub <em>가이드</em></span>
        </a>
        <nav aria-label="주요 메뉴" class="menu">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
        <button type="button" id="theme" class="theme" aria-label="화면 테마 전환">
          <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap">
          <p class="eyebrow">전남대학교 오픈소스 SW 개발 사업단</p>
          <h1>프로그램 탐색부터<br />제출·검토까지, 한곳에서.</h1>
          <p class="lede">
            OSS Hub는 학생의 오픈소스 활동과 교직원의 프로그램 운영을 연결하는 웹 서비스입니다.
            이 가이드는 역할별로 화면에서 무엇을 어떻게 하는지 안내합니다.
          </p>
          <div class="cta">
            <a class="btn primary" href={`${base}/start/`}>시작하기</a>
            <a class="btn" href={serviceUrl}>OSS Hub 열기</a>
          </div>
        </div>
        <div class="wrap">
          <div class="frame frame-hero">
            {shot(hero.name)
              ? <Image src={shot(hero.name)} alt={hero.alt} widths={[960, 1440, 2000]} sizes="(min-width: 1200px) 1120px, 92vw" loading="eager" />
              : <span class="empty">화면 준비 중</span>}
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="about">
        <div class="wrap about">
          <h2 id="about">서비스 소개</h2>
          <p>
            프로그램 탐색과 팀 구성부터 신청, 서류 제출·검토, GitHub 저장소와 활동 확인까지 한곳에서 이어갑니다.
          </p>
          <ul class="facts">
            <li><strong>프로그램 탐색·신청</strong>일정과 참여 조건을 확인하고 신청을 준비합니다.</li>
            <li><strong>팀 구성·서류 제출</strong>팀원을 초대하고 서류별 마감과 제출 상태를 확인합니다.</li>
            <li><strong>GitHub 연동</strong>GitHub 계정으로 로그인하고 저장소를 연결해 활동을 확인합니다.</li>
          </ul>
        </div>
      </section>

      <section class="flow" aria-labelledby="flow-h">
        <div class="wrap">
          <h2 id="flow-h" class="section-title">참여 흐름</h2>
          {flow.map((s) => (
            <article class="step">
              <header>
                <span class="no" aria-hidden="true">{s.no}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </header>
              <div class="frame">
                {shot(s.name)
                  ? <Image src={shot(s.name)} alt={s.alt} widths={[640, 960, 1440]} sizes="(min-width: 1200px) 1120px, 92vw" />
                  : <span class="empty">화면 준비 중</span>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="roles" aria-labelledby="roles-h">
        <div class="wrap">
          <h2 id="roles-h" class="section-title">역할별 가이드</h2>
          <ul class="cards">
            {roles.map((r) => (
              <li>
                <a href={r.href}>
                  <h3>{r.name}</h3>
                  <p>{r.body}</p>
                  <span class="more">가이드 보기 <span aria-hidden="true">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="faq" aria-labelledby="faq-h">
        <div class="wrap faq-in">
          <div>
            <h2 id="faq-h" class="section-title">자주 묻는 질문</h2>
            <a class="link" href={`${base}/faq/`}>전체 보기 <span aria-hidden="true">→</span></a>
          </div>
          <div class="qa">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="outro">
        <div class="wrap">
          <h2>OSS Hub에서 바로 시작해 보세요.</h2>
          <div class="cta">
            <a class="btn primary" href={serviceUrl}>jnu-oss-hub.com</a>
            <a class="btn" href={`${base}/start/`}>시작하기 가이드</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap"><SiteNote /></div>
    </footer>

    <script>
      document.getElementById('theme')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
      });
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }
  body {
    margin: 0;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  h1, h2, h3, p, ul { margin: 0; }
  ul { padding: 0; list-style: none; }
  a { color: inherit; text-decoration: none; }
  .wrap { width: min(72rem, 100% - 2rem); margin-inline: auto; }
  @media (min-width: 48rem) { .wrap { width: min(72rem, 100% - 4rem); } }

  .skip {
    position: absolute; left: 1rem; top: -4rem; z-index: 20;
    padding: 0.5rem 0.9rem; border-radius: 0.5rem;
    background: var(--sl-color-white); color: var(--sl-color-black);
  }
  .skip:focus { top: 1rem; }

  .top {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--sl-color-black) 82%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--guide-line);
  }
  .top-in { display: flex; align-items: center; gap: 1rem; min-height: 3.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 700; color: var(--sl-color-white); letter-spacing: -0.02em; white-space: nowrap; }
  .brand em { font-style: normal; font-weight: 500; color: var(--sl-color-gray-3); }
  .menu { display: none; margin-left: auto; gap: 0.25rem; }
  .menu a { padding: 0.4rem 0.75rem; border-radius: 0.5rem; font-size: 0.9375rem; color: var(--sl-color-gray-2); }
  .menu a:hover { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  @media (min-width: 62rem) { .menu { display: flex; } }
  .theme {
    margin-left: auto; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border: 1px solid var(--guide-line); border-radius: 0.6rem; background: none;
    color: var(--sl-color-gray-1); cursor: pointer;
  }
  @media (min-width: 62rem) { .theme { margin-left: 0.25rem; } }
  .theme:hover { background: var(--sl-color-gray-6); }
  .i-sun { display: none; }
  html[data-theme='dark'] .i-sun { display: block; }
  html[data-theme='dark'] .i-moon { display: none; }

  .hero { padding: clamp(3rem, 8vw, 6.5rem) 0 0; position: relative; isolation: isolate; }
  .hero::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 38rem; z-index: -1;
    background:
      radial-gradient(60rem 26rem at 78% -8%, color-mix(in srgb, var(--sl-color-accent) 20%, transparent), transparent 70%);
  }
  .eyebrow { font-size: 0.875rem; font-weight: 600; letter-spacing: 0.01em; color: var(--guide-brand); }
  h1 {
    margin-top: 1rem; max-width: 18ch;
    font-size: clamp(2.25rem, 7vw + 0.5rem, 4.75rem); font-weight: 700; line-height: 1.15;
    letter-spacing: -0.03em; color: var(--sl-color-white);
  }
  .lede { margin-top: 1.5rem; max-width: 40rem; text-wrap: pretty; font-size: clamp(1rem, 0.6vw + 0.9rem, 1.1875rem); color: var(--sl-color-gray-2); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .btn {
    display: inline-flex; align-items: center; min-height: 2.9rem; padding: 0 1.4rem;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.7rem;
    font-weight: 600; color: var(--sl-color-white); transition: background 0.15s, border-color 0.15s;
  }
  .btn:hover { background: var(--sl-color-gray-6); }
  .btn.primary { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: var(--sl-color-black); }
  html[data-theme='light'] .btn.primary { color: #fff; }
  .btn.primary:hover { filter: brightness(1.1); }

  .frame {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden;
    border-radius: 0.9rem; background: var(--sl-color-gray-7);
    outline: 1px solid var(--guide-line); outline-offset: -1px; box-shadow: var(--guide-shadow);
  }
  .frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .frame-hero { margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  .empty {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 0.875rem; color: var(--sl-color-gray-4);
    background: linear-gradient(135deg, var(--sl-color-gray-7), var(--sl-color-gray-6));
  }

  .band { margin-top: clamp(4rem, 9vw, 8rem); border-block: 1px solid var(--guide-line); background: var(--sl-color-gray-7); }
  .about { display: grid; gap: 1.25rem; padding-block: clamp(3rem, 6vw, 5rem); }
  .about h2, .section-title { font-size: clamp(1.625rem, 2.6vw + 0.6rem, 2.75rem); font-weight: 800; line-height: 1.25; letter-spacing: -0.035em; color: var(--sl-color-white); }
  .about > p { max-width: 38rem; font-size: 1.0625rem; }
  .facts { display: grid; gap: 1px; margin-top: 1.5rem; background: var(--guide-line); border: 1px solid var(--guide-line); border-radius: 0.9rem; overflow: hidden; }
  .facts li { padding: 1.4rem 1.5rem; background: var(--sl-color-black); font-size: 0.9375rem; }
  .facts strong { display: block; margin-bottom: 0.35rem; font-size: 1.0625rem; color: var(--sl-color-white); }
  @media (min-width: 50rem) { .facts { grid-template-columns: repeat(3, 1fr); } }

  .flow { padding-top: clamp(4rem, 9vw, 8rem); }
  .step { margin-top: clamp(3rem, 7vw, 6rem); }
  .step header { display: grid; gap: 0.5rem 2rem; margin-bottom: 1.5rem; }
  .no {
    font-size: clamp(3rem, 8vw, 5.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums; color: transparent;
    -webkit-text-stroke: 1.5px var(--guide-brand);
  }
  .step h3 { font-size: clamp(1.375rem, 1.6vw + 0.9rem, 2rem); font-weight: 700; letter-spacing: -0.03em; color: var(--sl-color-white); }
  .step header p { max-width: 36rem; }
  @media (min-width: 56rem) {
    .step header { grid-template-columns: 9rem 1fr; grid-template-areas: 'no title' 'no body'; align-items: start; }
    .no { grid-area: no; }
    .step h3 { grid-area: title; align-self: end; }
    .step header p { grid-area: body; }
  }

  .roles { padding-top: clamp(4rem, 9vw, 8rem); }
  .cards { display: grid; gap: 1rem; margin-top: 2rem; }
  @media (min-width: 50rem) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .cards li { display: flex; }
  .cards a {
    display: flex; flex-direction: column; flex: 1; padding: 1.6rem;
    border: 1px solid var(--guide-line); border-radius: 0.9rem; background: var(--sl-color-gray-7);
    transition: border-color 0.15s, transform 0.15s;
  }
  .cards a:hover { border-color: var(--guide-brand); transform: translateY(-2px); }
  .cards h3 { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.03em; color: var(--sl-color-white); }
  .cards p { margin-top: 0.6rem; font-size: 0.9375rem; flex: 1; }
  .more { margin-top: 1.4rem; font-size: 0.9375rem; font-weight: 600; color: var(--guide-brand); }

  .faq { padding-top: clamp(4rem, 9vw, 8rem); }
  .faq-in { display: grid; gap: 2rem; }
  @media (min-width: 56rem) { .faq-in { grid-template-columns: 1fr 2fr; gap: 4rem; } }
  .link { display: inline-block; margin-top: 1rem; font-weight: 600; color: var(--guide-brand); }
  .qa { border-top: 1px solid var(--guide-line); }
  .qa details { border-bottom: 1px solid var(--guide-line); }
  .qa summary {
    display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem 0;
    font-size: 1.0625rem; font-weight: 600; color: var(--sl-color-white); cursor: pointer; list-style: none;
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary::after { content: '+'; font-weight: 400; color: var(--sl-color-gray-3); }
  .qa details[open] summary::after { content: '−'; }
  .qa details p { padding-bottom: 1.25rem; max-width: 38rem; }

  .outro { margin-top: clamp(4rem, 9vw, 8rem); padding-block: clamp(4rem, 9vw, 7rem); border-top: 1px solid var(--guide-line); background: var(--sl-color-gray-7); text-align: center; }
  .outro h2 { font-size: clamp(1.75rem, 3vw + 0.6rem, 3rem); font-weight: 800; letter-spacing: -0.035em; color: var(--sl-color-white); }
  .outro .cta { justify-content: center; }
  .foot { padding: 2rem 0 3rem; text-align: center; border-top: 1px solid var(--guide-line); }
</style>
