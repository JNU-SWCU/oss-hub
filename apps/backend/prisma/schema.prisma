generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 사용자 역할. 신규 사용자는 역할 선택 전 null이다(#109 계약 잠금) — @default를 두지 않는다.
enum Role {
  STUDENT
  STAFF
  ADMIN
}

/// 계정 생명주기. 역할과 독립적으로 권한 접근 가능 여부를 결정한다(#187, #188).
enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id                String        @id @default(cuid())
  githubId          BigInt        @unique
  nickname          String        @map("login")
  name              String?
  studentId         String?
  department        String?
  avatarUrl         String?
  accountStatus     AccountStatus @default(ACTIVE)
  /// #127 마감 알림 수신 이메일·수신 여부. 교직원이 설정 화면에서 직접 설정한다(opt-in 기본 off).
  notificationEmail String?
  notifyEnabled     Boolean       @default(false)
  /// 확정된 역할. 역할 선택만으로는 채워지지 않는다 — 학생은 가입을 마칠 때(프로필 완료) STUDENT가
  /// 붙고, 교직원은 요청이 승인될 때에만 STAFF가 된다(#109, #569).
  role              Role?
  /// 가입 절차에서 **고른** 역할 — 기록일 뿐 확정이 아니다(#569).
  ///
  /// `role`로는 이 사실을 담을 수 없다. 그 칸은 확정된 권한을 뜻해서, 프로필을 채우는 동안
  /// 채워 두면 아직 가입을 마치지 않은 사람이 그 역할의 화면에 들어간다. 그렇다고 비워 두면
  /// 프로필 화면이 무엇을 물어야 할지 모른다 — 교직원에게 학번을 요구하게 된다.
  ///
  /// 값은 STUDENT · STAFF · null뿐이다. ADMIN은 역할 선택 화면에 없는 값이라 여기 들어오지 않는다.
  selectedRole      Role?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  roleRequests                           RoleRequest[]                   @relation("RoleRequestUser")
  decidedRoleRequests                    RoleRequest[]                   @relation("RoleRequestDecidedBy")
  consents                               Consent[]
  applications                           Application[]                   @relation("ApplicationApplicant")
  processedApplications                  Application[]                   @relation("ApplicationProcessedBy")
  ledTeams                               Team[]                          @relation("TeamLeader")
  teamMemberships                        TeamMember[]
  sentTeamInvitations                    TeamInvitation[]                @relation("TeamInvitationInvitedBy")
  receivedTeamInvitations                TeamInvitation[]                @relation("TeamInvitationInvitee")
  submissionRevisions                    SubmissionRevision[]
  uploadedFiles                          SubmissionFile[]
  reviews                                Review[]
  uploadedMilestoneDocumentTemplateFiles MilestoneDocumentTemplateFile[]
  milestoneDocumentSubmissions           MilestoneDocumentSubmission[]
  boardPosts                             BoardPost[]
  boardComments                          BoardComment[]
  notifications                          Notification[]
  auditLogs                              AuditLog[]
  loginHistories                         LoginHistory[]
  profile                                UserProfile?
}

/// 플랫폼에서 직접 수집·확정한 비공개 사용자 프로필.
/// expand 단계에서는 User의 legacy 프로필 컬럼과 함께 유지한다.
model UserProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  studentId  String   @unique
  department String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum LoginHistoryEvent {
  LOGIN
  LOGOUT
}

/// 로그인 활동 기록. IP·User-Agent는 수집하지 않는다(#157).
model LoginHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  event    LoginHistoryEvent
  provider String            @default("github")
  success  Boolean
  loginAt  DateTime          @default(now())

  @@index([userId, loginAt])
  @@index([userId, provider, event, success, loginAt, id])
  @@index([userId, provider, loginAt, id])
}

/// PENDING → APPROVED/REJECTED. REVOKED는 회수(REVOKE) 이력을 표현한다(#109 계약 잠금 이행 — #113에서 additive로 추가).
enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// 교직원 권한 요청 이력. 회수(REVOKE)도 상태를 지우지 않고 이력으로 남긴다(#108이 소비).
/// 사용자당 PENDING 1건 제한 partial unique는 Prisma로 표현할 수 없어 마이그레이션 SQL에 둔다(#164).
model RoleRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("RoleRequestUser", fields: [userId], references: [id])

  status          RoleRequestStatus @default(PENDING)
  rejectionReason String?

  decidedById String?
  decidedBy   User?     @relation("RoleRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status, createdAt, id])
  @@index([userId, createdAt, id])
}

/// 전역 개인정보·활동 동의. MVP는 정책 버전별 1회 동의만 저장한다(#109 계약 잠금) — programId를 두지 않는다.
model Consent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  policyVersion String
  consentedAt   DateTime @default(now())

  @@unique([userId, policyVersion])
}

/// 프로그램 유형 7종 고정(#109 계약 잠금) — 임의 필드 빌더는 post-pilot.
enum ProgramCategory {
  BASIC
  SW_VALUE_SPREAD
  OSS_CONTEST
  CAPSTONE
  SW_CONVERGENCE
  GLOBAL_MAKERTHON
  CORPORATE_INTERNSHIP
}

/// 기간·팀 인원 CHECK 3건은 Prisma로 표현할 수 없어 마이그레이션 SQL에 둔다(#164).
/// NULL 피연산자는 CHECK를 통과하므로 개인형 프로그램의 nullable 인원 필드는 유지된다.
enum ProgramLifecycle {
  PUBLISHED
  ARCHIVED
}

model Program {
  id        String           @id @default(cuid())
  name      String
  organizer String
  category  ProgramCategory
  lifecycle ProgramLifecycle @default(PUBLISHED)

  /// 서버 고정 registry가 결정한다(#100) — 클라이언트가 임의 값을 보낼 수 없다.
  applicationTemplateKey     String
  applicationTemplateVersion Int

  applicationStartAt DateTime
  applicationEndAt   DateTime
  /// null = 미종료; 공개 적격성 판정은 endAt 경과가 필요하다(#264).
  endAt              DateTime?

  /// 개인형 프로그램은 둘 다 null이다(#109 계약 잠금).
  teamMinSize Int?
  teamMaxSize Int?

  description String

  /// Intake 프로그램은 false, Full-loop 프로그램만 true로 켤 수 있다(#113).
  repositoryProvisioningEnabled Boolean @default(false)
  /// #127 프로그램별 마감 임박 알림 발송 여부. 값은 #127 발송 배치가 참조하고, 폼 토글 UI는 #100 소관이다.
  notifyOnDeadline              Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones   Milestone[]
  applications Application[]
  teams        Team[]
  repositories Repository[]
  boardPosts   BoardPost[]
}

/// 제출물 유형 — #113 Submission·#115 제출 API가 정확히 이 값 이름을 사용한다.
enum MilestoneSubmissionType {
  FILE
  TEXT
  REPOSITORY_RELEASE
}

model Milestone {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  name           String
  dueAt          DateTime
  submissionType MilestoneSubmissionType
  instructions   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions     Submission[]
  submissionFiles SubmissionFile[]
  /// 마일스톤 하나에 서류 항목 여러 개(예: #3 "개인정보 동의서"/"프로젝트 계획서"/"팀 구성 확인서").
  /// 기존 submissionType(마일스톤당 단일 제출 유형)은 하위호환을 위해 그대로 둔다 — 서류 항목이
  /// 없는 마일스톤(#1/#2/#5/#7)은 계속 이 필드만으로 동작한다.
  documents       MilestoneDocument[]

  @@index([programId])
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// teamId는 nullable이다 — 개인형은 null, 팀형만 API 검증으로 필수(#109 계약 잠금).
/// 개인·팀 중복 신청 방지 partial unique는 Prisma로 표현할 수 없어 마이그레이션 SQL에 둔다(#164).
model Application {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  applicantId String
  applicant   User   @relation("ApplicationApplicant", fields: [applicantId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  /// 7종 고정 템플릿 field별 응답(#118 계약을 따른다).
  answers                    Json
  applicationTemplateVersion Int

  /// 저장소 공개 예정 선택(#414 DEC-33/34) — 제출 시 1회 결정, 이후 수정 endpoint는 두지 않는다.
  isRepositoryPublicationPlanned Boolean @default(true)

  status          ApplicationStatus @default(SUBMITTED)
  rejectionReason String?

  submittedAt DateTime @default(now())

  processedById String?
  processedBy   User?     @relation("ApplicationProcessedBy", fields: [processedById], references: [id])
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions                  Submission[]
  repository                   Repository?
  provisionJob                 RepositoryProvisionJob?
  submissionFiles              SubmissionFile[]              @relation("SubmissionFileApplication")
  milestoneDocumentSubmissions MilestoneDocumentSubmission[]

  @@index([programId])
  @@index([applicantId])
  @@index([teamId])
}

model Team {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  name           String
  /// 참여코드는 평문을 저장하지 않고 HMAC-SHA-256 digest만 저장한다(#164).
  /// 전역 고유다(프로그램 범위 고유보다 강한 조건이라 #105 요구를 포함한다). 로그에 남기지 않는다(#105).
  joinCodeDigest String @unique

  leaderId String
  leader   User   @relation("TeamLeader", fields: [leaderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  applications Application[]
  repositories Repository[]
  invitations  TeamInvitation[]

  /// TeamMember의 비정규화 programId를 composite FK로 검증하기 위한 참조 대상(#164).
  @@unique([id, programId])
  @@index([programId])
}

/// 학과·이름·연락처·이메일은 합류 시 본인 입력(#109) — 팀장 생성 시점엔 비어 있을 수 있어 nullable로 둔다.
model TeamMember {
  id        String @id @default(cuid())
  teamId    String
  /// Team.programId의 비정규화 사본. composite FK가 팀과 프로그램의 정합을 강제한다(#164).
  programId String
  team      Team   @relation(fields: [teamId, programId], references: [id, programId])
  userId    String
  user      User   @relation(fields: [userId], references: [id])

  department String?
  name       String?
  phone      String?
  email      String?

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@unique([programId, userId])
  @@index([userId])
}

/// PENDING → ACCEPTED/DECLINED/EXPIRED. 참여코드(joinCodeDigest) 합류 방식은 그대로 두고,
/// 검색으로 상대를 찾아 초대·상대가 수락하는 방식을 추가한 것이다(PM 결정).
/// 동일 (teamId, inviteeId)에 PENDING이 동시에 여럿 존재하는 것을 막는 partial unique는
/// Prisma로 표현할 수 없어 마이그레이션 SQL에 둔다(#164 패턴).
enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model TeamInvitation {
  id String @id @default(cuid())

  teamId    String
  /// Team.programId의 비정규화 사본. TeamMember와 동일하게 composite FK로 팀·프로그램 정합을
  /// 강제한다(#164 패턴).
  programId String
  team      Team   @relation(fields: [teamId, programId], references: [id, programId])

  inviteeId String
  invitee   User   @relation("TeamInvitationInvitee", fields: [inviteeId], references: [id])

  invitedById String
  invitedBy   User   @relation("TeamInvitationInvitedBy", fields: [invitedById], references: [id])

  status TeamInvitationStatus @default(PENDING)

  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([programId, inviteeId])
  @@index([inviteeId, status])
}

/// 게시글 종류는 작성자 역할이 정한다 — 교직원 작성은 NOTICE, 학생 작성은 QNA(#619 프로토타입
/// 스펙, "공지"/"질문" 2종 고정). 종류를 사용자가 직접 고르는 UI는 없다.
enum BoardPostCategory {
  NOTICE
  QNA
}

model BoardPost {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  category BoardPostCategory
  title    String
  body     String
  pinned   Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments BoardComment[]

  @@index([programId, pinned, createdAt])
}

model BoardComment {
  id     String    @id @default(cuid())
  postId String
  post   BoardPost @relation(fields: [postId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

/// 제출 현재 상태. REJECTED는 최종 반려, CHANGES_REQUESTED만 재제출 가능하다(#113 상태 enum 계약). D-day/OVERDUE는 Milestone.dueAt 파생 표시값이며 여기 저장하지 않는다.
enum SubmissionStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

/// application×milestone당 제출 헤더. 재제출은 SubmissionRevision을 새로 추가하고 currentRevision만 갱신한다(#113).
model Submission {
  id String @id @default(cuid())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  status          SubmissionStatus @default(SUBMITTED)
  currentRevision Int              @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions SubmissionRevision[]

  @@unique([applicationId, milestoneId])
  @@index([milestoneId])
}

/// 제출 이력. 재제출 시 이전 revision을 갱신·삭제하지 않고 새 행을 추가한다(#113).
model SubmissionRevision {
  id String @id @default(cuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])

  revision Int

  submissionType MilestoneSubmissionType
  content        Json
  comment        String?

  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  files  SubmissionFile[]
  review Review?

  @@unique([submissionId, revision])
  @@index([submittedById])
}

enum SubmissionFileLifecycle {
  PENDING
  ATTACHED
  DELETE_PENDING
  DELETED
}

/// storage key만 저장한다 — filesystem 절대경로·public URL을 저장/노출하지 않는다(#113).
/// pendingExpiresAt은 미첨부 업로드 정리 시계, expiresAt은 첨부 후 보존 시계로 서로 대체하지 않는다(#115).
model SubmissionFile {
  id String @id @default(cuid())

  uploaderId    String
  uploader      User         @relation(fields: [uploaderId], references: [id])
  applicationId String?
  application   Application? @relation("SubmissionFileApplication", fields: [applicationId], references: [id], onDelete: Restrict)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int

  submissionRevisionId          String?
  submissionRevision            SubmissionRevision?          @relation(fields: [submissionRevisionId], references: [id])
  /// 마일스톤별 서류 항목(#619 확장) 제출에 첨부된 파일. 기존 submissionRevisionId 경로와는
  /// 독립적이다 — 한 SubmissionFile 행이 두 경로를 동시에 채우지 않는다.
  milestoneDocumentSubmissionId String?
  milestoneDocumentSubmission   MilestoneDocumentSubmission? @relation(fields: [milestoneDocumentSubmissionId], references: [id])
  lifecycle                     SubmissionFileLifecycle      @default(ATTACHED)
  pendingExpiresAt              DateTime?
  expiresAt                     DateTime?

  deleteClaimedAt      DateTime?
  deleteClaimExpiresAt DateTime?
  deleteClaimOwner     String?
  deleteAttemptCount   Int       @default(0)
  nextDeleteAttemptAt  DateTime?
  lastDeleteError      String?
  deletedAt            DateTime?

  createdAt DateTime @default(now())

  @@index([uploaderId])
  @@index([applicationId, milestoneId, lifecycle])
  @@index([lifecycle, pendingExpiresAt])
  @@index([lifecycle, nextDeleteAttemptAt, deleteClaimExpiresAt])
  @@index([submissionRevisionId])
  @@index([milestoneDocumentSubmissionId])
}

/// 마일스톤 하나가 요구하는 서류 항목 정의(#3 "프로젝트 계획서 제출" → 3개 항목 등).
/// 기존 Milestone.submissionType(마일스톤당 단일 제출 유형)과 Submission/SubmissionRevision은
/// 그대로 두고 이 모델이 항목 단위 확장을 더한다 — 서류가 없는 마일스톤은 documents가 비어 있다.
model MilestoneDocument {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  name           String
  required       Boolean
  sortOrder      Int
  /// 기존 Milestone.submissionType과 동일한 enum을 재사용한다.
  submissionType MilestoneSubmissionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateFile MilestoneDocumentTemplateFile?
  submissions  MilestoneDocumentSubmission[]

  @@index([milestoneId, sortOrder])
}

/// 교직원이 올린 서류 항목별 양식 파일. 항목당 "현재 양식" 한 건만 유지하는 upsert 모양이라
/// History 접미사를 쓰지 않는다 — "양식 교체"는 이 행을 덮어쓴다(#164 명명 규칙 §4).
model MilestoneDocumentTemplateFile {
  id                  String            @id @default(cuid())
  milestoneDocumentId String            @unique
  milestoneDocument   MilestoneDocument @relation(fields: [milestoneDocumentId], references: [id])

  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([uploadedById])
}

/// (서류 항목 × 신청/팀)당 제출 상태·시각. 행이 존재하지 않으면 "미제출"이다(status enum에
/// NOT_SUBMITTED를 두지 않는다 — DTO 계층이 없음을 'NOT_SUBMITTED' sentinel로 표현하는 기존
/// viewerSubmissionStatus 관례를 따른다). FILE 유형은 files로, TEXT/REPOSITORY_RELEASE 유형은
/// content Json으로 응답을 담는다.
model MilestoneDocumentSubmission {
  id String @id @default(cuid())

  milestoneDocumentId String
  milestoneDocument   MilestoneDocument @relation(fields: [milestoneDocumentId], references: [id])

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  status  SubmissionStatus @default(SUBMITTED)
  content Json?

  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files SubmissionFile[]

  @@unique([milestoneDocumentId, applicationId])
  @@index([applicationId])
  @@index([submittedById])
}

/// 판정: APPROVED/REJECTED/CHANGES_REQUESTED. 제출 판정과 저장소 공개 전환 상태를 같은 필드로 합치지 않는다(#113).
enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model Review {
  id String @id @default(cuid())

  submissionRevisionId String             @unique
  submissionRevision   SubmissionRevision @relation(fields: [submissionRevisionId], references: [id])

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  decision   ReviewDecision
  comment    String?
  reviewedAt DateTime       @default(now())

  @@index([reviewerId])
}

/// 공개 범위(#113 상태 enum 계약).
enum RepositoryVisibility {
  PRIVATE
  PUBLIC
}

/// application id당 최대 한 건 — 개인형도 지원해야 하므로 programId+teamId unique로 식별하지 않는다(#113 계약 잠금).
model Repository {
  id String @id @default(cuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  programId String
  program   Program @relation(fields: [programId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  githubRepositoryId BigInt @unique
  name               String
  url                String

  visibility  RepositoryVisibility @default(PRIVATE)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations  RepositoryInvitation[]
  provisionJob RepositoryProvisionJob?

  @@index([programId])
  @@index([teamId])
  /// todo 16 — `GET /projects` 목록 커서 페이지네이션(publishedAt desc, id desc)이 이 인덱스를 쓴다.
  @@index([visibility, publishedAt, id])
}

/// 공개 쿼리는 이 두 테이블만 조회한다(#126/#134); private 원본 join 금지.
/// todo 16 — ADR-003 공개 strict-read 예외 이후 신규 공개 read(`public-projects` 모듈)는
/// 이 규칙 대상이 아니다 — 전용 repository가 명시적 select로 `Repository` 원본을 직접 읽는다.
/// 이 두 테이블은 todo 20까지 유지되는 레거시 writer(`ShowcaseProjectionService`) 전용으로 남는다.
model PublicShowcaseRepository {
  repositoryId            String          @id
  githubRepositoryId      BigInt          @unique
  repositoryName          String
  repositoryUrl           String
  publishedAt             DateTime
  programId               String
  programName             String
  programCategory         ProgramCategory
  programEndAt            DateTime
  teamName                String?
  displayName             String
  approvedSubmissionCount Int
  projectedAt             DateTime        @updatedAt

  contributors PublicShowcaseContributor[]

  @@index([programId])
}

/// 공개 쿼리는 이 두 테이블만 조회한다(#126/#134); private 원본 join 금지.
model PublicShowcaseContributor {
  id             String                   @id @default(cuid())
  repositoryId   String
  repository     PublicShowcaseRepository @relation(fields: [repositoryId], references: [repositoryId], onDelete: Cascade)
  userId         String
  githubNickname String
  avatarUrl      String?

  @@unique([repositoryId, userId])
  @@index([userId])
}

enum RepositoryInvitationStatus {
  PENDING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
}

model RepositoryInvitation {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id])

  githubLogin String

  status              RepositoryInvitationStatus @default(PENDING)
  attemptCount        Int                        @default(0)
  reconciliationCount Int                        @default(0)

  lastErrorCode    String?
  lastErrorMessage String?
  processedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, githubLogin])
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/// idempotencyKey unique로 outbox 중복 처리를 방지한다. worker claim은 (status, availableAt) 인덱스를 사용한다(#113 계약).
model OutboxEvent {
  id String @id @default(cuid())

  type          String
  aggregateType String
  aggregateId   String

  idempotencyKey String @unique
  payload        Json

  status       OutboxEventStatus @default(PENDING)
  attemptCount Int               @default(0)
  availableAt  DateTime          @default(now())

  lockedAt DateTime?
  lockedBy String?

  processedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
}

enum RepositoryProvisionJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
}

/// application id당 최대 한 건. worker claim은 (status, nextAttemptAt) 인덱스를 사용한다(#113 계약).
model RepositoryProvisionJob {
  id String @id @default(cuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  repositoryId String?     @unique
  repository   Repository? @relation(fields: [repositoryId], references: [id])

  status        RepositoryProvisionJobStatus @default(PENDING)
  attemptCount  Int                          @default(0)
  nextAttemptAt DateTime                     @default(now())

  lockedAt DateTime?
  lockedBy String?

  lastErrorCode    String?
  lastErrorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

/// outbox나 저장소 job을 Notification으로 대신 구현하지 않는다(#113 계약).
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type           String
  payload        Json
  channel        String
  status         String
  idempotencyKey String? @unique

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// outbox나 job을 AuditLog로 대신 구현하지 않는다(#113 계약).
model AuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  action     String
  targetType String
  targetId   String
  metadata   Json

  occurredAt DateTime @default(now())

  @@index([actorId])
}

enum CollectionTrigger {
  SELF
  BATCH
}

enum CollectionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  RATE_LIMITED
}

enum ObservationSourceType {
  PROFILE
  REPO
  EVENT
}

model CollectionRun {
  id               String                 @id @default(cuid())
  targetGithubId   BigInt
  targetLogin      String
  trigger          CollectionTrigger
  status           CollectionRunStatus
  profileCount     Int                    @default(0)
  repoCount        Int                    @default(0)
  eventCount       Int                    @default(0)
  retryNotBeforeAt DateTime?
  startedAt        DateTime               @default(now())
  finishedAt       DateTime?
  observations     GithubRawObservation[]
}

model GithubRawObservation {
  id         String                @id @default(cuid())
  runId      String
  run        CollectionRun         @relation(fields: [runId], references: [id])
  sourceType ObservationSourceType
  sourceId   String
  payload    Json
  fetchedAt  DateTime              @default(now())

  @@unique([runId, sourceType, sourceId])
}

enum CanonicalCollectionRunStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  INCOMPLETE
  RATE_LIMITED
  FAILED
}

model CanonicalCollectionRun {
  id                String                           @id @default(cuid())
  appId             BigInt
  organizationLogin String
  status            CanonicalCollectionRunStatus     @default(PENDING)
  errorClass        String?
  createdAt         DateTime                         @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  repositories      CanonicalRepository[]
  commits           CanonicalDefaultBranchCommit[]
  pullRequests      CanonicalPullRequest[]
  releases          CanonicalRelease[]
  contributors      CanonicalContributorProjection[]
  leases            CanonicalCollectionLease[]
  activeFor         CanonicalOrganizationState[]     @relation("ActiveCanonicalGeneration")

  @@index([appId, organizationLogin, createdAt])
}

model CanonicalOrganizationState {
  appId                 BigInt
  organizationLogin     String
  activeGenerationId    String?
  activeGeneration      CanonicalCollectionRun? @relation("ActiveCanonicalGeneration", fields: [activeGenerationId], references: [id])
  installationValid     Boolean                 @default(false)
  permissionsValid      Boolean                 @default(false)
  installationCheckedAt DateTime?
  permissionsCheckedAt  DateTime?
  updatedAt             DateTime                @updatedAt

  @@id([appId, organizationLogin])
  @@index([activeGenerationId])
}

model CanonicalCollectionLease {
  appId             BigInt
  organizationLogin String
  epoch             BigInt                 @default(1)
  ownerId           String
  expiresAt         DateTime
  runId             String
  run               CanonicalCollectionRun @relation(fields: [runId], references: [id])
  updatedAt         DateTime               @updatedAt

  @@id([appId, organizationLogin])
  @@index([runId])
}

model CanonicalRepository {
  generationId       String
  githubRepositoryId BigInt
  fullName           String
  visibility         String
  archived           Boolean
  defaultBranch      String
  generation         CanonicalCollectionRun           @relation(fields: [generationId], references: [id], onDelete: Cascade)
  commits            CanonicalDefaultBranchCommit[]
  pullRequests       CanonicalPullRequest[]
  releases           CanonicalRelease[]
  contributors       CanonicalContributorProjection[]

  @@id([generationId, githubRepositoryId])
}

model CanonicalDefaultBranchCommit {
  generationId       String
  githubRepositoryId BigInt
  sha                String
  committedAt        DateTime
  authorGithubId     BigInt?
  authorGithubLogin  String?
  generation         CanonicalCollectionRun @relation(fields: [generationId], references: [id], onDelete: Cascade)
  repository         CanonicalRepository    @relation(fields: [generationId, githubRepositoryId], references: [generationId, githubRepositoryId], onDelete: Cascade)

  @@id([generationId, githubRepositoryId, sha])
  @@index([generationId, committedAt])
}

model CanonicalPullRequest {
  generationId        String
  githubRepositoryId  BigInt
  githubPullRequestId BigInt
  state               String
  createdAt           DateTime
  authorGithubId      BigInt?
  authorGithubLogin   String?
  generation          CanonicalCollectionRun @relation(fields: [generationId], references: [id], onDelete: Cascade)
  repository          CanonicalRepository    @relation(fields: [generationId, githubRepositoryId], references: [generationId, githubRepositoryId], onDelete: Cascade)

  @@id([generationId, githubRepositoryId, githubPullRequestId])
  @@index([generationId, createdAt])
}

model CanonicalRelease {
  generationId       String
  githubRepositoryId BigInt
  githubReleaseId    BigInt
  publishedAt        DateTime
  authorGithubId     BigInt?
  authorGithubLogin  String?
  generation         CanonicalCollectionRun @relation(fields: [generationId], references: [id], onDelete: Cascade)
  repository         CanonicalRepository    @relation(fields: [generationId, githubRepositoryId], references: [generationId, githubRepositoryId], onDelete: Cascade)

  @@id([generationId, githubRepositoryId, githubReleaseId])
  @@index([generationId, publishedAt])
}

model CanonicalContributorProjection {
  generationId                String
  githubRepositoryId          BigInt
  githubUserId                BigInt
  githubLogin                 String
  commitCount                 Int                    @default(0)
  pullRequestCount            Int                    @default(0)
  releaseCount                Int                    @default(0)
  currentYear                 Int
  currentYearCommitCount      Int                    @default(0)
  currentYearPullRequestCount Int                    @default(0)
  currentYearReleaseCount     Int                    @default(0)
  generation                  CanonicalCollectionRun @relation(fields: [generationId], references: [id], onDelete: Cascade)
  repository                  CanonicalRepository    @relation(fields: [generationId, githubRepositoryId], references: [generationId, githubRepositoryId], onDelete: Cascade)

  @@id([generationId, githubRepositoryId, githubUserId])
  @@index([generationId, githubUserId])
}

enum CollectionRepositoryPresence {
  PRESENT
  ABSENT
}

/// GithubRepository 통합 설계(.omc/plans/github-repository-unification.md §5)의 source 축 —
/// 별도 테이블이 아니라 이 컬럼으로 수집 방법 차이를 표현한다.
enum RepositorySource {
  ORG_PROVISIONED
  EXTERNAL_PUBLIC
}

/// ADR-006 조직 전체 누적·증분 수집의 논리 저장소 identity. App installation 교체와 무관하게
/// githubRepositoryId(GitHub 전역 고유)로 유일하다 — installation id는 identity에 포함하지 않는다.
/// visibility/presence는 complete inventory 관찰에서만 갱신된다(DEC-46, fail-closed 공개 회수).
/// 단계 C(github-repository-unification §7) 개명 — 구 CollectionRepository. githubOrganizationId는
/// EXTERNAL_PUBLIC 저장소가 조직 소속이 아니므로 nullable이다(R4). Repository(#449) 통합은 별도 단계(D)다.
model GithubRepository {
  id String @id @default(cuid())

  githubOrganizationId BigInt?
  githubRepositoryId   BigInt  @unique

  nameWithOwner String
  defaultBranch String?
  archived      Boolean @default(false)

  source RepositorySource

  visibility RepositoryVisibility         @default(PRIVATE)
  presence   CollectionRepositoryPresence @default(PRESENT)

  lastCompleteInventoryObservedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams          CollectionRepositoryStream[]
  commits          CollectionCommitFact[]
  pullRequests     CollectionPullRequestFact[]
  releases         CollectionReleaseFact[]
  yearAggregates   CollectionRepositoryYearAggregate[]
  contributorYears CollectionContributorYearAggregate[]

  @@index([source, visibility])
  @@index([visibility, presence])
}

enum CollectionStreamType {
  COMMIT
  PULL_REQUEST
  RELEASE
}

enum CollectionStreamStatus {
  PENDING
  BACKFILLING
  READY
  VERIFYING
}

/// stream(commit/PR/release)별 safe frontier + exact-request fingerprint/ETag를 보존해
/// 재순회 없이 다음 증분 수집 시작점을 복원한다(ADR-006).
model CollectionRepositoryStream {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  streamType CollectionStreamType
  status     CollectionStreamStatus @default(PENDING)

  frontierSha       String?
  frontierCreatedAt DateTime?
  frontierEntityId  BigInt?

  requestFingerprint String?
  etag               String?

  lastRunAt     DateTime?
  lastErrorAt   DateTime?
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, streamType])
  @@index([status])
}

/// commit fact = (repositoryId, sha) + committedAt만 보존한다 — message/author-email/diff는 저장하지 않는다(ADR-006).
model CollectionCommitFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  sha         String
  committedAt DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@index([authorGithubId])
}

/// PR fact = (repositoryId, githubPullRequestId) + observedAt만 보존한다 — title/body는 저장하지 않는다(ADR-006).
model CollectionPullRequestFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubPullRequestId BigInt
  state               String
  createdAt           DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, githubPullRequestId])
  @@index([repositoryId, createdAt])
  @@index([authorGithubId])
}

/// release fact = (repositoryId, githubReleaseId) + publishedAt만 보존한다 — body는 저장하지 않는다(ADR-006).
model CollectionReleaseFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubReleaseId BigInt
  publishedAt     DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, githubReleaseId])
  @@index([repositoryId, publishedAt])
  @@index([authorGithubId])
}

/// year를 별도 row로 키잉해 매년 1/1에 당해 연도 값을 0으로 안전하게 읽는다
/// (CanonicalContributorProjection의 단일 컬럼 currentYear 덮어쓰기 anti-pattern을 반복하지 않는다).
model CollectionRepositoryYearAggregate {
  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  year Int

  commitCount      Int @default(0)
  pullRequestCount Int @default(0)
  releaseCount     Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([repositoryId, year])
  @@index([year])
}

/// 기여자별 연도 누적 — repositoryId+githubUserId+year로 키잉해 Asia/Seoul 연 경계에서
/// 당해 연도 read가 항상 0부터 시작하도록 보장한다.
model CollectionContributorYearAggregate {
  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubUserId BigInt
  githubLogin  String

  year Int

  commitCount      Int @default(0)
  pullRequestCount Int @default(0)
  releaseCount     Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([repositoryId, githubUserId, year])
  @@index([repositoryId, year])
  @@index([githubUserId, year])
}

/// installation 재순회의 fair 연속 커서 — org 전체를 한 번에 처리하지 않고 rate-limit 인지 상태로
/// 다음 저장소부터 이어간다(ADR-006). appId+scope는 프로세스 키일 뿐 논리 저장소 identity에는 포함하지 않는다.
/// scope는 단계 C(github-repository-unification §3.1) 일반화 — org sweep은 "org:<login>", 외부 sweep은
/// "external"을 쓴다. 두 sweep이 서로 다른 리스·커서를 가져 예산을 다투지 않게 하기 위함이다(GR-9).
model CollectionSyncCursor {
  appId BigInt
  scope String

  lastGithubRepositoryId BigInt?
  cycleStartedAt         DateTime?
  cycleCompletedAt       DateTime?

  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

/// todo 10 sync orchestration의 epoch-fenced 상호배제 lease. `CanonicalCollectionLease`와 같은
/// 패턴(epoch 증가 + expiresAt fencing)을 쓰되, 별도 run 후보 테이블 없이 lease 자체가 "진행 중인
/// run"을 나타낸다 — 진행 bookkeeping인 `CollectionSyncCursor`와는 별개 관심사로 분리한다(ADR-006).
/// scope 규약은 `CollectionSyncCursor`와 동일(§3.1) — org sweep과 외부 sweep이 서로 다른 리스를 잡는다.
model CollectionSyncLease {
  appId     BigInt
  scope     String
  epoch     BigInt   @default(1)
  ownerId   String
  runId     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

/// todo 14 원자 전환(atomic reader/writer cutover) 절차 전용 quiesce lease. `CollectionSyncLease`와
/// 같은 epoch-fenced 패턴이다 — lease 보유 자체가 "cutover 진행 중"을 나타내며, 이 창(window) 동안
/// 스케줄러/관리자 트리거는 명시적으로 거부된다(silent skip이 아니라 별도 에러 코드로 reject한다).
/// 절차 완료(성공/abort 무관) 시 항상 해제해 트리거가 재개되도록 한다(ADR-006).
/// scope 규약은 `CollectionSyncCursor`와 동일(§3.1).
model CollectionCutoverLease {
  appId     BigInt
  scope     String
  epoch     BigInt   @default(1)
  ownerId   String
  runId     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}
