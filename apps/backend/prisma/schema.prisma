generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberKind {
  STUDENT
  STAFF
}

enum AffiliationKind {
  DEPARTMENT
  PROGRAM_OFFICE
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id                 String        @id @default(cuid())
  githubId           BigInt        @unique
  nickname           String        @map("login")
  avatarUrl          String?
  phone              String?
  accountStatus      AccountStatus @default(ACTIVE)
  sessionVersion     Int           @default(0)
  notificationEmail  String?
  notifyEnabled      Boolean       @default(false)
  selectedMemberKind MemberKind?
  hasStaffAccess     Boolean       @default(false)
  hasAdminAccess     Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  staffAccessRequests                    StaffAccessRequest[]                 @relation("StaffAccessRequestUser")
  decidedStaffAccessRequests             StaffAccessRequest[]                 @relation("StaffAccessRequestDecidedBy")
  consents                               Consent[]
  applications                           Application[]                        @relation("ApplicationApplicant")
  processedApplications                  Application[]                        @relation("ApplicationProcessedBy")
  applicationPreparations                ApplicationPreparation[]
  preparationParticipants                ApplicationPreparationParticipant[]
  ledTeams                               Team[]                               @relation("TeamLeader")
  teamMemberships                        TeamMember[]
  sentTeamInvitations                    TeamInvitation[]                     @relation("TeamInvitationInvitedBy")
  receivedTeamInvitations                TeamInvitation[]                     @relation("TeamInvitationInvitee")
  uploadedFiles                          SubmissionFile[]
  uploadedMilestoneDocumentTemplateFiles MilestoneDocumentTemplateFile[]
  programAuthoringUploads                ProgramAuthoringUpload[]
  programCreateRequests                  ProgramCreateRequest[]
  milestoneDocumentSubmissions           MilestoneDocumentSubmission[]
  milestoneDocumentSubmissionHistories   MilestoneDocumentSubmissionHistory[]
  milestoneDocumentReviewHistories       MilestoneDocumentReviewHistory[]
  applicationReviewHistories             ApplicationReviewHistory[]
  boardPosts                             BoardPost[]
  boardComments                          BoardComment[]
  notifications                          Notification[]
  auditLogs                              AuditLog[]
  loginHistories                         LoginHistory[]
  profile                                UserProfile?
}

model UserProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  studentId   String? @unique
  staffNumber String?
  department  String

  memberKind      MemberKind
  affiliationKind AffiliationKind
  affiliationName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LoginHistoryEvent {
  LOGIN
  LOGOUT
}

model LoginHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  event    LoginHistoryEvent
  provider String            @default("github")
  success  Boolean
  loginAt  DateTime          @default(now())

  @@index([userId, loginAt])
  @@index([userId, provider, event, success, loginAt, id])
  @@index([userId, provider, loginAt, id])
}

enum StaffAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model StaffAccessRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("StaffAccessRequestUser", fields: [userId], references: [id])

  status          StaffAccessRequestStatus @default(PENDING)
  rejectionReason String?

  decidedById String?
  decidedBy   User?     @relation("StaffAccessRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status, createdAt, id])
  @@index([userId, createdAt, id])
}

model Consent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  policyVersion String
  consentedAt   DateTime @default(now())

  @@unique([userId, policyVersion])
}

enum ProgramCategory {
  BASIC
  SW_VALUE_SPREAD
  OSS_CONTEST
  CAPSTONE
  SW_CONVERGENCE
  GLOBAL_MAKERTHON
  CORPORATE_INTERNSHIP
}

enum ProgramTrackType {
  CURRICULAR
  EXTRACURRICULAR
}

enum ProgramLifecycle {
  PUBLISHED
  ARCHIVED
}

model Program {
  id        String            @id @default(cuid())
  name      String
  organizer String
  category  ProgramCategory
  trackType ProgramTrackType?
  lifecycle ProgramLifecycle  @default(PUBLISHED)

  applicationTemplateKey     String
  applicationTemplateVersion Int

  applicationStartAt DateTime
  applicationEndAt   DateTime
  startAt            DateTime @default(dbgenerated("'0001-01-01 00:00:00'::timestamp without time zone"))
  endAt              DateTime @default(dbgenerated("'9999-12-31 23:59:59.999'::timestamp without time zone"))

  teamMinSize Int @default(1)
  teamMaxSize Int @default(1)

  description String

  repositoryProvisioningEnabled Boolean  @default(false)
  notifyOnDeadline              Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  milestones    Milestone[]
  applications  Application[]
  preparations  ApplicationPreparation[]
  teams         Team[]
  repositories  GithubRepository[]
  boardPosts    BoardPost[]
  createRequest ProgramCreateRequest?
  cover         ProgramCover?
}

enum ProgramCoverSource {
  OWNED
  EXTERNAL
}

model ProgramCover {
  id         String             @id @default(cuid())
  programId  String             @unique
  program    Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  source     ProgramCoverSource @default(OWNED)
  storageKey String?            @unique @db.VarChar(512)
  mimeType   String?            @db.VarChar(127)
  sizeBytes  Int?
  sourceUrl  String?            @db.VarChar(2048)
  imageUrl   String?            @db.VarChar(2048)
}

enum MilestoneSubmissionType {
  FILE
  TEXT
}

model Milestone {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  name           String
  startAt        DateTime                 @default(dbgenerated("'0001-01-01 00:00:00'::timestamp without time zone"))
  dueAt          DateTime
  submissionType MilestoneSubmissionType?
  instructions   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissionFiles SubmissionFile[]
  documents       MilestoneDocument[]

  @@index([programId])
}

enum ProgramAuthoringUploadLifecycle {
  PENDING
  ATTACHED
  DELETE_PENDING
  DELETED
}

enum ProgramPurgeFileTombstoneLifecycle {
  DELETE_PENDING
  DELETED
}

model ProgramPurgeFileTombstone {
  id String @id @default(cuid())

  storageKey String @unique @db.VarChar(512)

  lifecycle ProgramPurgeFileTombstoneLifecycle @default(DELETE_PENDING)

  deleteClaimedAt      DateTime?
  deleteClaimExpiresAt DateTime?
  deleteClaimOwner     String?   @db.VarChar(128)
  deleteAttemptCount   Int       @default(0)
  nextDeleteAttemptAt  DateTime?
  lastDeleteError      String?   @db.VarChar(64)
  deletedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lifecycle, nextDeleteAttemptAt, deleteClaimExpiresAt])
}

model ProgramAuthoringUpload {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  storageKey       String @unique @db.VarChar(512)
  originalFileName String @db.VarChar(255)
  mimeType         String @db.VarChar(127)
  sizeBytes        Int
  sha256           String @db.VarChar(64)

  lifecycle  ProgramAuthoringUploadLifecycle @default(PENDING)
  expiresAt  DateTime
  attachedAt DateTime?

  deleteClaimedAt      DateTime?
  deleteClaimExpiresAt DateTime?
  deleteClaimOwner     String?   @db.VarChar(128)
  deleteAttemptCount   Int       @default(0)
  nextDeleteAttemptAt  DateTime?
  lastDeleteError      String?   @db.VarChar(64)
  deletedAt            DateTime?

  createRequestActorId String?
  createRequestId      String?
  createRequest        ProgramCreateRequest? @relation(fields: [createRequestActorId, createRequestId], references: [actorId, id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actorId, lifecycle, expiresAt])
  @@index([lifecycle, nextDeleteAttemptAt, deleteClaimExpiresAt])
}

model ProgramCreateRequest {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  idempotencyKey String @db.VarChar(128)
  payloadHash    String @db.VarChar(64)

  programId String  @unique
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  uploads ProgramAuthoringUpload[]

  @@unique([actorId, idempotencyKey])
  @@unique([actorId, id])
  @@index([actorId, createdAt])
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum RepositoryConnectionMode {
  NEW
  OWN
}

model Application {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  applicantId String
  applicant   User   @relation("ApplicationApplicant", fields: [applicantId], references: [id])

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  answers                    Json
  applicationTemplateVersion Int

  isRepositoryPublicationPlanned Boolean @default(true)

  repositoryConnectionMode RepositoryConnectionMode @default(NEW)
  repositoryUrl            String?

  status          ApplicationStatus @default(SUBMITTED)
  rejectionReason String?

  revision Int @default(1)

  submittedAt DateTime @default(now())

  processedById String?
  processedBy   User?     @relation("ApplicationProcessedBy", fields: [processedById], references: [id])
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository                   GithubRepository?
  provisionJob                 RepositoryProvisionJob?
  submissionFiles              SubmissionFile[]              @relation("SubmissionFileApplication")
  milestoneDocumentSubmissions MilestoneDocumentSubmission[]
  reviewHistories              ApplicationReviewHistory[]

  @@unique([programId, teamId])
  @@index([programId])
  @@index([applicantId])
  @@index([teamId])
}

enum ApplicationReviewEventKind {
  SUBMITTED
  RESUBMITTED
  APPROVED
  REJECTED
  REVERTED
}

model ApplicationReviewHistory {
  id String @id @default(cuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  eventKind ApplicationReviewEventKind
  revision  Int

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  occurredAt DateTime @default(now())

  rejectionReason String?

  @@index([applicationId, occurredAt])
  @@index([actorId])
}

model Team {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  name           String
  joinCodeDigest String @unique

  leaderId String
  leader   User   @relation("TeamLeader", fields: [leaderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  applications Application[]
  repositories GithubRepository[]
  invitations  TeamInvitation[]

  @@unique([id, programId])
  @@index([programId])
}

model TeamMember {
  id        String @id @default(cuid())
  teamId    String
  programId String
  team      Team   @relation(fields: [teamId, programId], references: [id, programId])
  userId    String
  user      User   @relation(fields: [userId], references: [id])

  department String?
  name       String?
  email      String?

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@unique([programId, userId])
  @@index([userId])
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model TeamInvitation {
  id String @id @default(cuid())

  teamId    String
  programId String
  team      Team   @relation(fields: [teamId, programId], references: [id, programId])

  inviteeId String
  invitee   User   @relation("TeamInvitationInvitee", fields: [inviteeId], references: [id])

  invitedById String
  invitedBy   User   @relation("TeamInvitationInvitedBy", fields: [invitedById], references: [id])

  status TeamInvitationStatus @default(PENDING)

  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([programId, inviteeId])
  @@index([inviteeId, status])
}

enum BoardPostCategory {
  NOTICE
  QNA
}

model BoardPost {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  category BoardPostCategory
  title    String
  body     String
  pinned   Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments BoardComment[]

  @@index([programId, pinned, createdAt])
}

model BoardComment {
  id     String    @id @default(cuid())
  postId String
  post   BoardPost @relation(fields: [postId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum SubmissionFileLifecycle {
  PENDING
  ATTACHED
  DELETE_PENDING
  DELETED
}

model SubmissionFile {
  id String @id @default(cuid())

  uploaderId    String
  uploader      User         @relation(fields: [uploaderId], references: [id])
  applicationId String?
  application   Application? @relation("SubmissionFileApplication", fields: [applicationId], references: [id], onDelete: Restrict)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int

  milestoneDocumentSubmissionId        String?
  milestoneDocumentSubmission          MilestoneDocumentSubmission?        @relation(fields: [milestoneDocumentSubmissionId], references: [id])
  milestoneDocumentSubmissionHistoryId String?
  submissionHistory                    MilestoneDocumentSubmissionHistory? @relation(fields: [milestoneDocumentSubmissionHistoryId], references: [id], onDelete: Restrict, map: "SubmissionFile_submissionHistoryId_fkey")
  lifecycle                            SubmissionFileLifecycle             @default(ATTACHED)
  pendingExpiresAt                     DateTime?
  expiresAt                            DateTime?

  deleteClaimedAt      DateTime?
  deleteClaimExpiresAt DateTime?
  deleteClaimOwner     String?
  deleteAttemptCount   Int       @default(0)
  nextDeleteAttemptAt  DateTime?
  lastDeleteError      String?
  deletedAt            DateTime?

  createdAt DateTime @default(now())

  @@index([uploaderId])
  @@index([applicationId, milestoneId, lifecycle])
  @@index([lifecycle, pendingExpiresAt])
  @@index([lifecycle, nextDeleteAttemptAt, deleteClaimExpiresAt])
  @@index([milestoneDocumentSubmissionId])
  @@index([milestoneDocumentSubmissionHistoryId])
}

enum MilestoneDocumentKind {
  DOCUMENT
  LEGACY_MILESTONE_SUBMISSION
}

model MilestoneDocument {
  graceDueAt  DateTime?
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  name      String
  required  Boolean
  sortOrder Int
  kind      MilestoneDocumentKind @default(DOCUMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateFile MilestoneDocumentTemplateFile?
  submissions  MilestoneDocumentSubmission[]

  @@index([milestoneId, sortOrder])
}

model MilestoneDocumentTemplateFile {
  id                  String            @id @default(cuid())
  milestoneDocumentId String            @unique
  milestoneDocument   MilestoneDocument @relation(fields: [milestoneDocumentId], references: [id])

  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([uploadedById])
}

model MilestoneDocumentSubmission {
  id String @id @default(cuid())

  legacySubmissionId String? @unique

  milestoneDocumentId String
  milestoneDocument   MilestoneDocument @relation(fields: [milestoneDocumentId], references: [id])

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  status  SubmissionStatus @default(SUBMITTED)
  content Json?

  revision Int @default(1)

  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files           SubmissionFile[]
  reviewHistories MilestoneDocumentReviewHistory[]
  histories       MilestoneDocumentSubmissionHistory[]

  @@unique([milestoneDocumentId, applicationId])
  @@index([applicationId])
  @@index([submittedById])
}

enum MilestoneDocumentSubmissionHistoryEvent {
  SUBMITTED
  RESUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

model MilestoneDocumentSubmissionHistory {
  id String @id @default(cuid())

  milestoneDocumentSubmissionId String
  submission                    MilestoneDocumentSubmission @relation(fields: [milestoneDocumentSubmissionId], references: [id], onDelete: Restrict, map: "MilestoneDocumentSubmissionHistory_submissionId_fkey")

  event    MilestoneDocumentSubmissionHistoryEvent
  revision Int?
  content  Json?
  comment  String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  files           SubmissionFile[]
  reviewHistories MilestoneDocumentReviewHistory[]

  @@index([milestoneDocumentSubmissionId, createdAt])
  @@index([actorId])
}

model MilestoneDocumentReviewHistory {
  id String @id @default(cuid())

  milestoneDocumentSubmissionId String
  milestoneDocumentSubmission   MilestoneDocumentSubmission @relation(fields: [milestoneDocumentSubmissionId], references: [id])

  submissionHistoryId String?
  submissionHistory   MilestoneDocumentSubmissionHistory? @relation(fields: [submissionHistoryId], references: [id], onDelete: Restrict, map: "MilestoneDocumentReviewHistory_submissionHistoryId_fkey")

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  decision   ReviewDecision
  comment    String?
  reviewedAt DateTime       @default(now())

  resubmissionDueAt DateTime?

  @@index([milestoneDocumentSubmissionId, reviewedAt])
  @@index([reviewerId])
  @@index([submissionHistoryId])
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum RepositoryVisibility {
  PRIVATE
  PUBLIC
}

enum RepositoryInvitationStatus {
  PENDING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
  REVOKE_REQUIRED
  REVOKED
  REVOKE_FAILED_RETRYABLE
  REVOKE_FAILED_FINAL
}

model RepositoryInvitation {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id])

  githubLogin String

  status              RepositoryInvitationStatus @default(PENDING)
  attemptCount        Int                        @default(0)
  reconciliationCount Int                        @default(0)

  lastErrorCode    String?
  lastErrorMessage String?
  processedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, githubLogin])
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id String @id @default(cuid())

  type          String
  aggregateType String
  aggregateId   String

  idempotencyKey String @unique
  payload        Json

  status       OutboxEventStatus @default(PENDING)
  attemptCount Int               @default(0)
  availableAt  DateTime          @default(now())

  lockedAt DateTime?
  lockedBy String?

  processedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
}

enum RepositoryProvisionJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
}

model RepositoryProvisionJob {
  id String @id @default(cuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  repositoryId String?
  repository   GithubRepository? @relation(fields: [repositoryId], references: [id])

  currentEventId String?

  status        RepositoryProvisionJobStatus @default(PENDING)
  attemptCount  Int                          @default(0)
  nextAttemptAt DateTime                     @default(now())

  lockedAt DateTime?
  lockedBy String?

  lastErrorCode    String?
  lastErrorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

model RepositoryIssuanceHistory {
  id String @id @default(cuid())

  requestId String @unique

  applicationId String
  repositoryId  String?

  connectionMode RepositoryConnectionMode
  source         RepositorySource?

  outcome       RepositoryIssuanceOutcome
  lastErrorCode String?

  requestedAt DateTime
  closedAt    DateTime
  createdAt   DateTime @default(now())

  @@index([applicationId])
}

enum RepositoryIssuanceOutcome {
  SUCCEEDED
  FAILED_FINAL
  DISCARDED
  SUPERSEDED
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type           String
  payload        Json
  channel        String
  status         String
  idempotencyKey String? @unique

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  action     String
  targetType String
  targetId   String
  metadata   Json

  occurredAt DateTime @default(now())

  @@index([actorId])
}

enum CollectionRepositoryPresence {
  PRESENT
  ABSENT
}

enum RepositorySource {
  ORG_PROVISIONED
  EXTERNAL_PUBLIC
}

model GithubRepository {
  id String @id @default(cuid())

  githubOrganizationId BigInt?
  githubRepositoryId   BigInt  @unique

  nameWithOwner String
  defaultBranch String?
  archived      Boolean @default(false)

  source RepositorySource

  visibility RepositoryVisibility         @default(PRIVATE)
  presence   CollectionRepositoryPresence @default(PRESENT)

  lastCompleteInventoryObservedAt DateTime?

  nextRunAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)

  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Restrict)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams       CollectionRepositoryStream[]
  commits       CollectionCommitFact[]
  pullRequests  CollectionPullRequestFact[]
  releases      CollectionReleaseFact[]
  issues        GithubIssueHistory[]
  contributions Contribution[]
  outsider      GithubRepositoryOutsiderContribution?
  invitations   RepositoryInvitation[]
  provisionJobs RepositoryProvisionJob[]

  @@index([source, visibility])
  @@index([visibility, presence])
  @@index([nextRunAt])
  @@index([programId])
  @@index([teamId])
  @@index([visibility, publishedAt, id])
}

model Contribution {
  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubId BigInt

  date DateTime @db.Date

  commitCount      Int @default(0)
  pullRequestCount Int @default(0)
  releaseCount     Int @default(0)
  issueCount       Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([repositoryId, githubId, date])
  @@index([githubId, date])
  @@index([date])
}

enum ActivityVisibility {
  PUBLIC
  PRIVATE
}

model GithubUserActivityHistory {
  githubId    BigInt
  githubLogin String
  year        Int
  visibility  ActivityVisibility @default(PUBLIC)

  commitCount      Int @default(0)
  pullRequestCount Int @default(0)
  issueCount       Int @default(0)
  repositoryCount  Int @default(0)
  starCount        Int @default(0)

  observedAt DateTime

  @@id([githubId, year, visibility])
  @@index([year])
}

enum CollectionStreamType {
  COMMIT
  PULL_REQUEST
  RELEASE
  ISSUE
}

enum CollectionStreamStatus {
  PENDING
  BACKFILLING
  READY
  VERIFYING
}

model CollectionRepositoryStream {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  streamType CollectionStreamType
  status     CollectionStreamStatus @default(PENDING)

  frontierSha       String?
  frontierCreatedAt DateTime?
  frontierEntityId  BigInt?

  requestFingerprint String?
  etag               String?

  lastRunAt     DateTime?
  lastErrorAt   DateTime?
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, streamType])
  @@index([status])
}

model CollectionCommitFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  sha         String
  committedAt DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@index([authorGithubId])
}

model CollectionPullRequestFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubPullRequestId BigInt
  state               String
  createdAt           DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, githubPullRequestId])
  @@index([repositoryId, createdAt])
  @@index([authorGithubId])
}

model CollectionReleaseFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubReleaseId BigInt
  publishedAt     DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, githubReleaseId])
  @@index([repositoryId, publishedAt])
  @@index([authorGithubId])
}

model GithubIssueHistory {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubIssueId BigInt
  state         String
  createdAt     DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, githubIssueId])
  @@index([repositoryId, createdAt])
  @@index([authorGithubId])
}

model GithubRepositoryOutsiderContribution {
  repositoryId String           @id
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  applicationId String
  programId     String
  windowStartAt DateTime
  windowEndAt   DateTime

  commitCount      Int
  pullRequestCount Int
  issueCount       Int

  observedAt DateTime
}

model CollectionSyncCursor {
  appId BigInt
  scope String

  lastGithubRepositoryId BigInt?
  cycleStartedAt         DateTime?
  cycleCompletedAt       DateTime?

  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

model CollectionSyncLease {
  appId     BigInt
  scope     String
  epoch     BigInt   @default(1)
  ownerId   String
  runId     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

model CollectionCutoverLease {
  appId     BigInt
  scope     String
  epoch     BigInt   @default(1)
  ownerId   String
  runId     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

enum CollectionRunKind {
  SWEEP
  REPOSITORY_LINK
}

model CollectionSweepHistory {
  id String @id @default(cuid())

  appId BigInt
  scope String

  sweepFinishedAt DateTime
  cycleStartedAt  DateTime?

  insertedCommitCount      Int
  insertedPullRequestCount Int
  insertedReleaseCount     Int
  insertedIssueCount       Int @default(0)

  attemptedRepositoryCount Int
  processedRepositoryCount Int
  failedRepositoryCount    Int

  cycleCompleted   Boolean
  stoppedForBudget Boolean

  kind CollectionRunKind @default(SWEEP)

  @@index([sweepFinishedAt])
}

model ApplicationPreparation {
  id           String                              @id @default(cuid())
  programId    String
  program      Program                             @relation(fields: [programId], references: [id], onDelete: Cascade)
  leaderId     String
  leader       User                                @relation(fields: [leaderId], references: [id])
  name         String
  createdAt    DateTime                            @default(now())
  participants ApplicationPreparationParticipant[]

  @@unique([id, programId])
  @@unique([programId, leaderId])
}

model ApplicationPreparationParticipant {
  id            String                 @id @default(cuid())
  preparationId String
  programId     String
  preparation   ApplicationPreparation @relation(fields: [preparationId, programId], references: [id, programId], onDelete: Cascade)
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  status        TeamInvitationStatus   @default(PENDING)
  invitedAt     DateTime               @default(now())
  respondedAt   DateTime?

  @@unique([preparationId, userId])
  @@index([programId, userId, status])
}
