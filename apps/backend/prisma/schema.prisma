generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  UNSELECTED
  STUDENT
  STAFF
}

enum DepartmentType {
  DEPARTMENT
  PROGRAM_OFFICE
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum AdminOrigin {
  ADMIN
  BOOTSTRAP
  MIGRATION
}

enum HistorySource {
  APPLICATION
  BOOTSTRAP
  MIGRATION
}

enum UserHistoryEvent {
  SIGNED_UP
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
  REVOKED
  REQUEST_SUPERSEDED
  TYPE_CHANGED
  PROFILE_UPDATED
  PHONE_UPDATED
  ACCOUNT_STATUS_CHANGED
  LEGACY_IMPORT
}

enum AdminHistoryEvent {
  GRANTED
  REVOKED
  LEGACY_IMPORT
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id                  String          @id @default(cuid())
  githubId            BigInt          @unique
  nickname            String          @map("login")
  avatarUrl           String?
  phone               String?
  accountStatus       AccountStatus   @default(ACTIVE)
  sessionVersion      Int             @default(0)
  notificationEmail   String?
  notifyEnabled       Boolean         @default(false)
  type                UserType        @default(UNSELECTED)
  name                String?
  /// CHECK User_studentId_requires_student_check: non-null only for STUDENT.
  studentId           String?         @unique
  staffNumber         String?
  department          String?
  departmentType      DepartmentType?
  profileCreatedAt    DateTime?
  profileUpdatedAt    DateTime?
  approvalStatus      ApprovalStatus  @default(NOT_REQUIRED)
  approvalRequestId   String?         @unique
  approvalRequestedAt DateTime?
  approvalDecidedAt   DateTime?
  approvalDecidedById String?
  approvalReason      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  approvalDecidedBy       User?               @relation("UserApprovalDecider", fields: [approvalDecidedById], references: [id], onDelete: Restrict)
  approvalDecisions       User[]              @relation("UserApprovalDecider")
  admin                   Admin?              @relation("AdminUser")
  adminGrants             Admin[]             @relation("AdminGrantor")
  userHistories           UserHistory[]       @relation("UserHistorySubject")
  actedUserHistories      UserHistory[]       @relation("UserHistoryActor")
  adminHistories          AdminHistory[]      @relation("AdminHistorySubject")
  actedAdminHistories     AdminHistory[]      @relation("AdminHistoryActor")
  policies                UserPolicy[]
  submittedTeams          Team[]              @relation("TeamApplicant")
  processedTeams          Team[]              @relation("TeamProcessedBy")
  ledTeams                Team[]              @relation("TeamLeader")
  teamMemberships         TeamMember[]
  sentTeamInvitations     TeamInvitation[]    @relation("TeamInvitationInvitedBy")
  receivedTeamInvitations TeamInvitation[]    @relation("TeamInvitationInvitee")
  uploadedFiles           File[]
  createdPrograms         Program[]
  submissions             Submission[]
  submissionHistories     SubmissionHistory[]
  boardPosts              BoardPost[]
  boardComments           BoardComment[]
  notifications           Notification[]
  loginHistories          LoginHistory[]
}

model Admin {
  userId      String      @id
  user        User        @relation("AdminUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedAt   DateTime    @default(now())
  grantedById String?
  grantedBy   User?       @relation("AdminGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  origin      AdminOrigin
}

model UserHistory {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("UserHistorySubject", fields: [userId], references: [id], onDelete: Restrict)
  actorId     String?
  actor       User?            @relation("UserHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)
  event       UserHistoryEvent
  occurredAt  DateTime         @default(now())
  recordedAt  DateTime         @default(now())
  source      HistorySource
  sourceTable String?
  sourceId    String?
  sourcePart  String?          @default("whole")
  data        Json

  @@unique([sourceTable, sourceId, sourcePart])
  @@index([userId, occurredAt, id])
  @@index([actorId, occurredAt, id])
}

model AdminHistory {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation("AdminHistorySubject", fields: [userId], references: [id], onDelete: Restrict)
  actorId     String?
  actor       User?             @relation("AdminHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)
  event       AdminHistoryEvent
  occurredAt  DateTime          @default(now())
  recordedAt  DateTime          @default(now())
  source      HistorySource
  sourceTable String?
  sourceId    String?
  sourcePart  String?           @default("whole")
  data        Json

  @@unique([sourceTable, sourceId, sourcePart])
  @@index([userId, occurredAt, id])
  @@index([actorId, occurredAt, id])
}

enum LoginHistoryEvent {
  LOGIN
  LOGOUT
}

model LoginHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  event    LoginHistoryEvent
  provider String            @default("github")
  success  Boolean
  loginAt  DateTime          @default(now())

  @@index([userId, loginAt])
  @@index([userId, provider, event, success, loginAt, id])
  @@index([userId, provider, loginAt, id])
}

model UserPolicy {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  policyVersion String
  consentedAt   DateTime @default(now())

  @@unique([userId, policyVersion])
}

enum ProgramCategory {
  BASIC
  SW_VALUE_SPREAD
  OSS_CONTEST
  CAPSTONE
  SW_CONVERGENCE
  GLOBAL_MAKERTHON
  CORPORATE_INTERNSHIP
}

enum ProgramTrackType {
  CURRICULAR
  EXTRACURRICULAR
}

enum ProgramLifecycle {
  PUBLISHED
  DELETED
}

enum ProgramCreatedBy {
  USER
  LEGACY_UNKNOWN
}

model Program {
  coverFileId    String?           @unique
  coverFile      File?             @relation("ProgramCoverFile", fields: [coverFileId], references: [id], onDelete: Restrict)
  coverSourceUrl String?           @db.VarChar(2048)
  coverImageUrl  String?           @db.VarChar(2048)
  files          File[]            @relation("ProgramFiles")
  id             String            @id @default(cuid())
  name           String
  organizer      String
  category       ProgramCategory
  trackType      ProgramTrackType?
  lifecycle      ProgramLifecycle  @default(PUBLISHED)

  createdBy      ProgramCreatedBy @default(LEGACY_UNKNOWN)
  createdById    String?
  creator        User?            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  idempotencyKey String?          @db.VarChar(128)
  payloadHash    String?          @db.VarChar(64)

  applicationTemplateKey     String
  applicationTemplateVersion Int

  applicationStartAt DateTime
  applicationEndAt   DateTime
  startAt            DateTime
  endAt              DateTime

  teamMinSize Int @default(1)
  teamMaxSize Int @default(1)

  description String

  repositoryProvisioningEnabled Boolean  @default(false)
  notifyOnDeadline              Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  milestones Milestone[]
  teams      Team[]
  boardPosts BoardPost[]

  @@unique([createdById, idempotencyKey])
  @@unique([createdById, id])
}

model Milestone {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  name         String
  startAt      DateTime
  dueAt        DateTime
  instructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements Requirement[]

  @@index([programId])
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum RepositoryConnectionMode {
  NEW
  OWN
}

model Team {
  files     File[]
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  name String

  leaderId String
  leader   User   @relation("TeamLeader", fields: [leaderId], references: [id])

  applicantId                    String
  applicant                      User                     @relation("TeamApplicant", fields: [applicantId], references: [id])
  answers                        Json
  applicationTemplateVersion     Int
  status                         ApplicationStatus        @default(SUBMITTED)
  revision                       Int                      @default(1)
  submittedAt                    DateTime                 @default(now())
  processedById                  String?
  processedBy                    User?                    @relation("TeamProcessedBy", fields: [processedById], references: [id])
  processedAt                    DateTime?
  rejectionReason                String?
  isRepositoryPublicationPlanned Boolean                  @default(true)
  repositoryConnectionMode       RepositoryConnectionMode @default(NEW)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  members      TeamMember[]
  repository   GithubRepository?
  teamRepos    TeamRepo[]
  provisionJob RepositoryProvisionJob?
  submissions  Submission[]
  invitations  TeamInvitation[]

  @@unique([id, programId])
  @@index([programId])
  @@index([applicantId])
  @@index([programId, status, submittedAt])
}

model TeamMember {
  teamId    String
  programId String
  team      Team   @relation(fields: [teamId, programId], references: [id, programId])
  userId    String
  user      User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@unique([programId, userId])
  @@index([userId])
}

enum TeamHistoryEvent {
  SUBMITTED
  APPROVED
  REJECTED
  REVERTED
  RESUBMITTED
  REPOSITORY_URL_CHANGED
  DELETED
  MEMBER_LEFT
  MEMBER_REMOVED
  LEADER_TRANSFERRED
  RENAMED
  INVITATION_ARCHIVED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_CANCELLED
  CREATED
  JOINED
  REPOSITORY_PUBLISHED
}

model TeamHistory {
  id          String           @id @default(cuid())
  teamId      String
  programId   String
  actorId     String?
  event       TeamHistoryEvent
  occurredAt  DateTime         @default(now())
  recordedAt  DateTime         @default(now())
  source      HistorySource
  sourceTable String?
  sourceId    String?
  data        Json

  @@unique([sourceTable, sourceId])
  @@index([teamId, occurredAt, id])
  @@index([programId, occurredAt, id])
  @@index([actorId, occurredAt, id])
}

enum ProgramHistoryEvent {
  CREATED
  DELETED
}

model ProgramHistory {
  id          String              @id @default(cuid())
  programId   String
  actorId     String?
  event       ProgramHistoryEvent
  occurredAt  DateTime            @default(now())
  recordedAt  DateTime            @default(now())
  source      HistorySource
  sourceTable String?
  sourceId    String?
  data        Json

  @@unique([sourceTable, sourceId])
  @@index([programId, occurredAt, id])
  @@index([actorId, occurredAt, id])
}

model TeamInvitation {
  id String @id @default(cuid())

  teamId    String
  programId String
  team      Team   @relation(fields: [teamId, programId], references: [id, programId])

  inviteeId String
  invitee   User   @relation("TeamInvitationInvitee", fields: [inviteeId], references: [id])

  invitedById String
  invitedBy   User   @relation("TeamInvitationInvitedBy", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, inviteeId])
  @@index([teamId])
  @@index([programId, inviteeId])
  @@index([inviteeId])
}

enum BoardPostCategory {
  NOTICE
  QNA
}

model BoardPost {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  category BoardPostCategory
  title    String
  body     String
  pinned   Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments BoardComment[]

  @@index([programId, pinned, createdAt])
}

model BoardComment {
  id     String    @id @default(cuid())
  postId String
  post   BoardPost @relation(fields: [postId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum RequirementSubmissionType {
  FILE
  TEXT
  FILE_OR_TEXT
}

model Requirement {
  files       File[]
  graceDueAt  DateTime?
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  name           String
  required       Boolean
  sortOrder      Int
  submissionType RequirementSubmissionType @default(FILE_OR_TEXT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]

  @@index([milestoneId, sortOrder])
}

model Submission {
  id String @id @default(cuid())

  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])

  status  SubmissionStatus @default(SUBMITTED)
  content Json?

  revision Int @default(1)

  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files     File[]
  histories SubmissionHistory[]

  @@unique([requirementId, teamId])
  @@index([teamId])
  @@index([submittedById])
}

enum SubmissionHistoryEvent {
  SUBMITTED
  RESUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

model SubmissionHistory {
  id String @id @default(cuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  event    SubmissionHistoryEvent
  revision Int?
  content  Json?
  comment  String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  files File[]

  @@index([submissionId, createdAt])
  @@index([actorId])
}

enum FileKind {
  UPLOAD
  TEMPLATE
  COVER
  SUBMISSION
}

enum FileLifecycle {
  PENDING
  ATTACHED
  DELETE_PENDING
  DELETED
}

model File {
  id                   String             @id @default(cuid())
  kind                 FileKind
  lifecycle            FileLifecycle
  storageKey           String             @unique
  originalFileName     String?
  mimeType             String?
  sizeBytes            Int?
  sha256               String?            @db.VarChar(64)
  uploaderId           String?
  uploader             User?              @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  programId            String?
  program              Program?           @relation("ProgramFiles", fields: [programId], references: [id], onDelete: Restrict)
  coverForProgram      Program?           @relation("ProgramCoverFile")
  requirementId        String?
  requirement          Requirement?       @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  teamId               String?
  team                 Team?              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  submissionId         String?
  submission           Submission?        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  submissionHistoryId  String?
  submissionHistory    SubmissionHistory? @relation(fields: [submissionHistoryId], references: [id], onDelete: Restrict)
  pendingExpiresAt     DateTime?
  expiresAt            DateTime?
  attachedAt           DateTime?
  deleteClaimedAt      DateTime?
  deleteClaimExpiresAt DateTime?
  deleteClaimOwner     String?
  deleteAttemptCount   Int                @default(0)
  nextDeleteAttemptAt  DateTime?
  lastDeleteError      String?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt

  @@index([uploaderId])
  @@index([teamId, requirementId, lifecycle])
  @@index([lifecycle, pendingExpiresAt])
  @@index([lifecycle, nextDeleteAttemptAt, deleteClaimExpiresAt])
  @@index([programId])
  @@index([requirementId])
  @@index([submissionId])
  @@index([submissionHistoryId])
}

enum RepositoryVisibility {
  PRIVATE
  PUBLIC
}

enum RepositoryInvitationStatus {
  PENDING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
  REVOKE_REQUIRED
  REVOKED
  REVOKE_FAILED_RETRYABLE
  REVOKE_FAILED_FINAL
}

model RepositoryInvitation {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id])

  githubLogin String

  status              RepositoryInvitationStatus @default(PENDING)
  attemptCount        Int                        @default(0)
  reconciliationCount Int                        @default(0)

  lastErrorCode    String?
  lastErrorMessage String?
  processedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, githubLogin])
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id String @id @default(cuid())

  type          String
  aggregateType String
  aggregateId   String

  idempotencyKey String @unique
  payload        Json

  status       OutboxEventStatus @default(PENDING)
  attemptCount Int               @default(0)
  availableAt  DateTime          @default(now())

  lockedAt DateTime?
  lockedBy String?

  processedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
}

enum RepositoryProvisionJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
}

model RepositoryProvisionJob {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id])

  repositoryId String?
  repository   GithubRepository? @relation(fields: [repositoryId], references: [id])

  currentEventId String?

  status        RepositoryProvisionJobStatus @default(PENDING)
  attemptCount  Int                          @default(0)
  nextAttemptAt DateTime                     @default(now())

  lockedAt DateTime?
  lockedBy String?

  lastErrorCode    String?
  lastErrorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

model RepositoryIssuanceHistory {
  id String @id @default(cuid())

  requestId    String  @unique
  teamId       String
  repositoryId String?

  connectionMode RepositoryConnectionMode
  source         RepositorySource?

  outcome       RepositoryIssuanceOutcome
  lastErrorCode String?

  requestedAt DateTime
  closedAt    DateTime
  createdAt   DateTime @default(now())

  @@index([teamId])
}

enum RepositoryIssuanceOutcome {
  SUCCEEDED
  FAILED_FINAL
  DISCARDED
  SUPERSEDED
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type           String
  payload        Json
  channel        String
  status         String
  idempotencyKey String? @unique

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum CollectionRepositoryPresence {
  PRESENT
  ABSENT
}

enum RepositorySource {
  ORG_PROVISIONED
  EXTERNAL_PUBLIC
}

model GithubRepository {
  id String @id @default(cuid())

  githubOrganizationId BigInt?
  githubRepositoryId   BigInt  @unique

  nameWithOwner String
  defaultBranch String?
  archived      Boolean @default(false)

  source RepositorySource

  visibility RepositoryVisibility         @default(PRIVATE)
  presence   CollectionRepositoryPresence @default(PRESENT)

  lastCompleteInventoryObservedAt DateTime?

  nextRunAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)

  teamId String? @unique
  team   Team?   @relation(fields: [teamId], references: [id])

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams       CollectionRepositoryStream[]
  invitations   RepositoryInvitation[]
  provisionJobs RepositoryProvisionJob[]

  @@index([source, visibility])
  @@index([visibility, presence])
  @@index([nextRunAt])
  @@index([teamId])
  @@index([visibility, publishedAt, id])
}

enum ActivityVisibility {
  PUBLIC
  PRIVATE
}

model GithubUserActivityMonthly {
  githubId BigInt
  year     Int
  month    Int

  commitCount      Int @default(0)
  pullRequestCount Int @default(0)
  issueCount       Int @default(0)
  repositoryCount  Int @default(0)
  starCount        Int @default(0)

  observedAt DateTime

  @@id([githubId, year, month])
  @@index([year])
}

enum CollectionStreamType {
  COMMIT
  PULL_REQUEST
  RELEASE
  ISSUE
}

enum CollectionStreamStatus {
  PENDING
  BACKFILLING
  READY
  VERIFYING
}

model CollectionRepositoryStream {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  streamType CollectionStreamType
  status     CollectionStreamStatus @default(PENDING)

  frontierSha       String?
  frontierCreatedAt DateTime?
  frontierEntityId  BigInt?

  requestFingerprint String?
  etag               String?

  lastRunAt     DateTime?
  lastErrorAt   DateTime?
  lastErrorCode String?

  syncEpoch BigInt? @map("sync_epoch")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, streamType])
  @@index([status])
}

model CollectionSyncCursor {
  appId BigInt
  scope String

  lastGithubRepositoryId BigInt?
  cycleStartedAt         DateTime?
  cycleCompletedAt       DateTime?

  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

model CollectionSyncLease {
  appId     BigInt
  scope     String
  epoch     BigInt   @default(1)
  ownerId   String
  runId     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

model CollectionCutoverLease {
  appId     BigInt
  scope     String
  epoch     BigInt   @default(1)
  ownerId   String
  runId     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

enum ContributionKind {
  COMMIT       @map("commit")
  PULL_REQUEST @map("pull_request")
  ISSUE        @map("issue")
  RELEASE      @map("release")

  @@map("contribution_kind")
}

model Repo {
  githubRepoId BigInt           @id @map("github_repo_id")
  ownerName    String           @map("owner_name")
  source       RepositorySource
  goneAt       DateTime?        @map("gone_at") @db.Timestamptz(3)

  defaultBranch String?                      @map("default_branch")
  archived      Boolean                      @default(false)
  visibility    RepositoryVisibility         @default(PRIVATE)
  presence      CollectionRepositoryPresence @default(PRESENT)
  publishedAt   DateTime?                    @map("published_at") @db.Timestamptz(3)
  lastSuccessAt DateTime?                    @map("last_success_at") @db.Timestamptz(3)

  teamRepos     TeamRepo[]
  contributions ContributionEvent[]

  @@map("repo")
}

/// One team and one repository in any overlapping period. Both exclusion constraints are SQL-only.
model TeamRepo {
  teamId    String                   @map("team_id")
  team      Team                     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  repoId    BigInt                   @map("repo_id")
  repo      Repo                     @relation(fields: [repoId], references: [githubRepoId])
  validFrom DateTime                 @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime?                @map("valid_to") @db.Timestamptz(3)
  period    Unsupported("tstzrange") @default(dbgenerated("tstzrange(valid_from, valid_to, '[)'::text)")) @map("period")

  @@id([teamId, repoId, validFrom])
  @@map("team_repo")
}

model ContributionEvent {
  repoId         BigInt           @map("repo_id")
  repo           Repo             @relation(fields: [repoId], references: [githubRepoId])
  kind           ContributionKind
  githubKey      String           @map("github_key")
  authorGithubId BigInt?          @map("author_github_id")
  occurredAt     DateTime         @map("occurred_at") @db.Timestamptz(3)
  firstSeenAt    DateTime         @map("first_seen_at") @db.Timestamptz(3)

  @@id([repoId, kind, githubKey])
  @@index([authorGithubId, occurredAt])
  @@index([repoId, occurredAt])
  @@map("contribution")
}

model GithubUserActivityObservation {
  githubId         BigInt             @map("github_id")
  year             Int
  visibility       ActivityVisibility
  commitCount      Int                @default(0) @map("commit_count")
  pullRequestCount Int                @default(0) @map("pull_request_count")
  issueCount       Int                @default(0) @map("issue_count")
  repositoryCount  Int                @default(0) @map("repository_count")
  starCount        Int                @default(0) @map("star_count")
  observedAt       DateTime           @map("observed_at") @db.Timestamptz(3)
  clockAt          DateTime?          @map("clock_at") @db.Timestamptz(3)

  @@id([githubId, year, visibility, observedAt])
  @@map("github_user_activity_history")
}
