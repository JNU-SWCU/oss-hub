generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 회원 유형. 권한과 독립적으로 학생·교직원 정체성을 표현한다.
enum MemberKind {
  STUDENT
  STAFF
}

/// 현재 소속의 유형.
enum AffiliationKind {
  DEPARTMENT
  PROGRAM_OFFICE
}

/// 계정 생명주기. 역할과 독립적으로 권한 접근 가능 여부를 결정한다(#187, #188).
enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id                 String        @id @default(cuid())
  githubId           BigInt        @unique
  nickname           String        @map("login")
  avatarUrl          String?
  accountStatus      AccountStatus @default(ACTIVE)
  sessionVersion     Int           @default(0)
  /// #127 마감 알림 수신 이메일·수신 여부. 교직원이 설정 화면에서 직접 설정한다(opt-in 기본 off).
  notificationEmail  String?
  notifyEnabled      Boolean       @default(false)
  /// 가입 절차에서 **고른** 회원 유형 — 기록일 뿐 접근 권한이 아니다.
  ///
  /// 프로필을 채우는 동안 무엇을 물어야 하는지(학생이면 학번) 아는 유일한 근거다.
  /// 아직 아무것도 고르지 않은 사용자는 null이다.
  selectedMemberKind MemberKind?
  /// 교직원·관리자 접근 권한. 서로를 함의하지 않는다 — 관리자가 곧 교직원은 아니다.
  hasStaffAccess     Boolean       @default(false)
  hasAdminAccess     Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  staffAccessRequests                    StaffAccessRequest[]             @relation("StaffAccessRequestUser")
  decidedStaffAccessRequests             StaffAccessRequest[]             @relation("StaffAccessRequestDecidedBy")
  consents                               Consent[]
  applications                           Application[]                    @relation("ApplicationApplicant")
  processedApplications                  Application[]                    @relation("ApplicationProcessedBy")
  ledTeams                               Team[]                           @relation("TeamLeader")
  teamMemberships                        TeamMember[]
  sentTeamInvitations                    TeamInvitation[]                 @relation("TeamInvitationInvitedBy")
  receivedTeamInvitations                TeamInvitation[]                 @relation("TeamInvitationInvitee")
  submissionRevisions                    SubmissionRevision[]
  uploadedFiles                          SubmissionFile[]
  reviews                                Review[]
  uploadedMilestoneDocumentTemplateFiles MilestoneDocumentTemplateFile[]
  programAuthoringUploads                ProgramAuthoringUpload[]
  programCreateRequests                  ProgramCreateRequest[]
  milestoneDocumentSubmissions           MilestoneDocumentSubmission[]
  milestoneDocumentReviewHistories       MilestoneDocumentReviewHistory[]
  boardPosts                             BoardPost[]
  boardComments                          BoardComment[]
  notifications                          Notification[]
  auditLogs                              AuditLog[]
  loginHistories                         LoginHistory[]
  profile                                UserProfile?
}

/// 플랫폼에서 직접 수집·확정한 비공개 사용자 프로필. 회원 정체성의 유일한 정본이다.
/// 행이 존재한다는 것은 곧 가입을 마쳤다는 뜻이다.
model UserProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 비어 있지 않고 1~100 코드 포인트. NFC 정규화는 쓰기 경계 불변식이다
  /// — stock PostgreSQL에 정규화 제약이 없어 DB는 길이·공백만 막는다(마이그레이션 CHECK).
  name String
  /// STUDENT는 필수·전역 유일, STAFF는 null이다. 정확히 6자리 규칙은 새 쓰기 경계가
  /// 지킨다 — 6~10자리 legacy 값이 남아 있어 DB는 그 보존 형식까지 받는다(마이그레이션 CHECK).
  studentId String? @unique
  /// `affiliationName`의 legacy 사본. 두 값은 언제나 같다(마이그레이션 CHECK).
  department String

  memberKind      MemberKind
  affiliationKind AffiliationKind
  affiliationName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LoginHistoryEvent {
  LOGIN
  LOGOUT
}

/// 로그인 활동 기록. IP·User-Agent는 수집하지 않는다(#157).
model LoginHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  event    LoginHistoryEvent
  provider String            @default("github")
  success  Boolean
  loginAt  DateTime          @default(now())

  @@index([userId, loginAt])
  @@index([userId, provider, event, success, loginAt, id])
  @@index([userId, provider, loginAt, id])
}

/// PENDING → APPROVED/REJECTED. REVOKED는 회수(REVOKE) 이력을 표현한다(#109 계약 잠금 이행 — #113에서 additive로 추가).
enum StaffAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// 교직원 접근 권한 요청 이력. 회수(REVOKE)도 상태를 지우지 않고 이력으로 남긴다(#108이 소비).
/// 사용자당 PENDING 1건 제한 partial unique는 Prisma로 표현할 수 없어 마이그레이션 SQL에 둔다(#164).
model StaffAccessRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("StaffAccessRequestUser", fields: [userId], references: [id])

  status          StaffAccessRequestStatus @default(PENDING)
  rejectionReason String?

  decidedById String?
  decidedBy   User?     @relation("StaffAccessRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status, createdAt, id])
  @@index([userId, createdAt, id])
}

/// 전역 개인정보·활동 동의. MVP는 정책 버전별 1회 동의만 저장한다(#109 계약 잠금) — programId를 두지 않는다.
model Consent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  policyVersion String
  consentedAt   DateTime @default(now())

  @@unique([userId, policyVersion])
}

/// 프로그램 유형 7종 고정(#109 계약 잠금) — 임의 필드 빌더는 post-pilot.
enum ProgramCategory {
  BASIC
  SW_VALUE_SPREAD
  OSS_CONTEST
  CAPSTONE
  SW_CONVERGENCE
  GLOBAL_MAKERTHON
  CORPORATE_INTERNSHIP
}

/// 기간·팀 인원 CHECK는 Prisma로 표현할 수 없어 마이그레이션 SQL에 둔다(#164, #739).
enum ProgramLifecycle {
  PUBLISHED
  ARCHIVED
}

model Program {
  id        String           @id @default(cuid())
  name      String
  organizer String
  category  ProgramCategory
  lifecycle ProgramLifecycle @default(PUBLISHED)

  /// 서버 고정 registry가 결정한다(#100) — 클라이언트가 임의 값을 보낼 수 없다.
  applicationTemplateKey     String
  applicationTemplateVersion Int

  applicationStartAt DateTime
  applicationEndAt   DateTime
  startAt            DateTime @default(dbgenerated("'0001-01-01 00:00:00'::timestamp without time zone"))
  endAt              DateTime @default(dbgenerated("'9999-12-31 23:59:59.999'::timestamp without time zone"))

  /// 모든 유형이 1..1에서 시작하며 작성자가 유효한 범위로 편집할 수 있다(#739).
  teamMinSize Int @default(1)
  teamMaxSize Int @default(1)

  description String

  /// Intake 프로그램은 false, Full-loop 프로그램만 true로 켤 수 있다(#113).
  repositoryProvisioningEnabled Boolean @default(false)
  /// #127 프로그램별 마감 임박 알림 발송 여부. 값은 #127 발송 배치가 참조하고, 폼 토글 UI는 #100 소관이다.
  notifyOnDeadline              Boolean @default(false)
  /// true면 가드 delete·purge 모두 서비스 계층에서 무조건 거부한다(ADMIN도 우회 불가) — API에는
  /// 이 값을 바꾸는 경로가 없다, 운영자가 DB에서 직접 켠다(F2 finding #1). oss-hub 자체 운영
  /// 프로그램처럼 어떤 모드에서도 삭제되면 안 되는 행을 표시한다.
  deletionProtected             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones    Milestone[]
  applications  Application[]
  teams         Team[]
  repositories  GithubRepository[]
  boardPosts    BoardPost[]
  createRequest ProgramCreateRequest?
}

/// 제출물 유형 — #113 Submission·#115 제출 API가 정확히 이 값 이름을 사용한다.
enum MilestoneSubmissionType {
  FILE
  TEXT
}

model Milestone {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  name           String
  startAt        DateTime                @default(dbgenerated("'0001-01-01 00:00:00'::timestamp without time zone"))
  dueAt          DateTime
  submissionType MilestoneSubmissionType
  instructions   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions     Submission[]
  submissionFiles SubmissionFile[]
  /// 마일스톤 하나에 서류 항목 여러 개(예: #3 "개인정보 동의서"/"프로젝트 계획서"/"팀 구성 확인서").
  /// 기존 submissionType(마일스톤당 단일 제출 유형)은 하위호환을 위해 그대로 둔다 — 서류 항목이
  /// 없는 마일스톤(#1/#2/#5/#7)은 계속 이 필드만으로 동작한다.
  documents       MilestoneDocument[]

  @@index([programId])
}

enum ProgramAuthoringUploadLifecycle {
  PENDING
  ATTACHED
  DELETE_PENDING
  DELETED
}

enum ProgramPurgeFileTombstoneLifecycle {
  DELETE_PENDING
  DELETED
}

/// Program purge가 MilestoneDocumentTemplateFile을 지운 뒤에도 storageKey를 보존하는 삭제 대기 행.
/// 트랜잭션에서는 이 행만 만들고, 실제 객체 삭제는 별도 worker가 수행한다.
model ProgramPurgeFileTombstone {
  id String @id @default(cuid())

  storageKey String @unique @db.VarChar(512)

  lifecycle ProgramPurgeFileTombstoneLifecycle @default(DELETE_PENDING)

  deleteClaimedAt      DateTime?
  deleteClaimExpiresAt DateTime?
  deleteClaimOwner     String?   @db.VarChar(128)
  deleteAttemptCount   Int       @default(0)
  nextDeleteAttemptAt  DateTime?
  lastDeleteError      String?   @db.VarChar(64)
  deletedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lifecycle, nextDeleteAttemptAt, deleteClaimExpiresAt])
}

/// 최종 Program 작성 전에 교직원이 올린 임시 양식 파일. storageKey는 서버가 생성한다.
model ProgramAuthoringUpload {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  storageKey       String @unique @db.VarChar(512)
  originalFileName String @db.VarChar(255)
  mimeType         String @db.VarChar(127)
  sizeBytes        Int
  sha256           String @db.VarChar(64)

  lifecycle  ProgramAuthoringUploadLifecycle @default(PENDING)
  expiresAt  DateTime
  attachedAt DateTime?

  deleteClaimedAt      DateTime?
  deleteClaimExpiresAt DateTime?
  deleteClaimOwner     String?   @db.VarChar(128)
  deleteAttemptCount   Int       @default(0)
  nextDeleteAttemptAt  DateTime?
  lastDeleteError      String?   @db.VarChar(64)
  deletedAt            DateTime?

  createRequestActorId String?
  createRequestId      String?
  createRequest        ProgramCreateRequest? @relation(fields: [createRequestActorId, createRequestId], references: [actorId, id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actorId, lifecycle, expiresAt])
  @@index([lifecycle, nextDeleteAttemptAt, deleteClaimExpiresAt])
}

/// actor별 idempotency key가 같은 최종 작성 재시도를 원 Program에 연결한다.
model ProgramCreateRequest {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  idempotencyKey String @db.VarChar(128)
  payloadHash    String @db.VarChar(64)

  programId String  @unique
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  uploads ProgramAuthoringUpload[]

  @@unique([actorId, idempotencyKey])
  @@unique([actorId, id])
  @@index([actorId, createdAt])
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// 저장소 연결 방식 — 제출 시 1회 결정, 이후 수정 endpoint는 두지 않는다.
enum RepositoryConnectionMode {
  NEW
  OWN
}

/// 모든 신청은 Team을 갖는다. 개인 참여는 멤버 1명인 팀이다(사용자 결정 D5 — 기존 #109 nullable 계약을 대체).
/// (programId, teamId) full unique. 1 프로그램당 1 팀 소속은 TeamMember @@unique([programId, userId])가 막고,
/// 1 팀당 1 신청은 이 unique가 막아 신청자 중복을 성립시킨다.
model Application {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  applicantId String
  applicant   User   @relation("ApplicationApplicant", fields: [applicantId], references: [id])

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  /// 7종 고정 템플릿 field별 응답(#118 계약을 따른다).
  answers                    Json
  applicationTemplateVersion Int

  /// 저장소 공개 예정 선택(#414 DEC-33/34) — 제출 시 1회 결정, 이후 수정 endpoint는 두지 않는다.
  isRepositoryPublicationPlanned Boolean @default(true)

  /// 저장소 연결 방식 — 제출 시 1회 결정, 이후 수정 endpoint는 두지 않는다.
  repositoryConnectionMode RepositoryConnectionMode @default(NEW)
  /// OWN일 때 연결할 기존 저장소 URL. NEW면 null.
  repositoryUrl            String?

  status          ApplicationStatus @default(SUBMITTED)
  rejectionReason String?

  submittedAt DateTime @default(now())

  processedById String?
  processedBy   User?     @relation("ApplicationProcessedBy", fields: [processedById], references: [id])
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions                  Submission[]
  repository                   GithubRepository?
  provisionJob                 RepositoryProvisionJob?
  submissionFiles              SubmissionFile[]              @relation("SubmissionFileApplication")
  milestoneDocumentSubmissions MilestoneDocumentSubmission[]

  @@unique([programId, teamId])
  @@index([programId])
  @@index([applicantId])
  @@index([teamId])
}

model Team {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  name           String
  /// 참여코드는 평문을 저장하지 않고 HMAC-SHA-256 digest만 저장한다(#164).
  /// 전역 고유다(프로그램 범위 고유보다 강한 조건이라 #105 요구를 포함한다). 로그에 남기지 않는다(#105).
  joinCodeDigest String @unique

  leaderId String
  leader   User   @relation("TeamLeader", fields: [leaderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  applications Application[]
  repositories GithubRepository[]
  invitations  TeamInvitation[]

  /// TeamMember의 비정규화 programId를 composite FK로 검증하기 위한 참조 대상(#164).
  @@unique([id, programId])
  @@index([programId])
}

/// 학과·이름·연락처·이메일은 합류 시 본인 입력(#109) — 팀장 생성 시점엔 비어 있을 수 있어 nullable로 둔다.
model TeamMember {
  id        String @id @default(cuid())
  teamId    String
  /// Team.programId의 비정규화 사본. composite FK가 팀과 프로그램의 정합을 강제한다(#164).
  programId String
  team      Team   @relation(fields: [teamId, programId], references: [id, programId])
  userId    String
  user      User   @relation(fields: [userId], references: [id])

  department String?
  name       String?
  phone      String?
  email      String?

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@unique([programId, userId])
  @@index([userId])
}

/// PENDING → ACCEPTED/DECLINED/EXPIRED. 참여코드(joinCodeDigest) 합류 방식은 그대로 두고,
/// 검색으로 상대를 찾아 초대·상대가 수락하는 방식을 추가한 것이다(PM 결정).
/// 동일 (teamId, inviteeId)에 PENDING이 동시에 여럿 존재하는 것을 막는 partial unique는
/// Prisma로 표현할 수 없어 마이그레이션 SQL에 둔다(#164 패턴).
enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model TeamInvitation {
  id String @id @default(cuid())

  teamId    String
  /// Team.programId의 비정규화 사본. TeamMember와 동일하게 composite FK로 팀·프로그램 정합을
  /// 강제한다(#164 패턴).
  programId String
  team      Team   @relation(fields: [teamId, programId], references: [id, programId])

  inviteeId String
  invitee   User   @relation("TeamInvitationInvitee", fields: [inviteeId], references: [id])

  invitedById String
  invitedBy   User   @relation("TeamInvitationInvitedBy", fields: [invitedById], references: [id])

  status TeamInvitationStatus @default(PENDING)

  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([programId, inviteeId])
  @@index([inviteeId, status])
}

/// 게시글 종류는 작성자 역할이 정한다 — 교직원 작성은 NOTICE, 학생 작성은 QNA(#619 프로토타입
/// 스펙, "공지"/"질문" 2종 고정). 종류를 사용자가 직접 고르는 UI는 없다.
enum BoardPostCategory {
  NOTICE
  QNA
}

model BoardPost {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  category BoardPostCategory
  title    String
  body     String
  pinned   Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments BoardComment[]

  @@index([programId, pinned, createdAt])
}

model BoardComment {
  id     String    @id @default(cuid())
  postId String
  post   BoardPost @relation(fields: [postId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

/// 제출 현재 상태. REJECTED는 최종 반려, CHANGES_REQUESTED만 재제출 가능하다(#113 상태 enum 계약). D-day/OVERDUE는 Milestone.dueAt 파생 표시값이며 여기 저장하지 않는다.
enum SubmissionStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

/// application×milestone당 제출 헤더. 재제출은 SubmissionRevision을 새로 추가하고 currentRevision만 갱신한다(#113).
model Submission {
  id String @id @default(cuid())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  status          SubmissionStatus @default(SUBMITTED)
  currentRevision Int              @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions SubmissionRevision[]

  @@unique([applicationId, milestoneId])
  @@index([milestoneId])
}

/// 제출 이력. 재제출 시 이전 revision을 갱신·삭제하지 않고 새 행을 추가한다(#113).
model SubmissionRevision {
  id String @id @default(cuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])

  revision Int

  submissionType MilestoneSubmissionType
  content        Json
  comment        String?

  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  files  SubmissionFile[]
  review Review?

  @@unique([submissionId, revision])
  @@index([submittedById])
}

enum SubmissionFileLifecycle {
  PENDING
  ATTACHED
  DELETE_PENDING
  DELETED
}

/// storage key만 저장한다 — filesystem 절대경로·public URL을 저장/노출하지 않는다(#113).
/// pendingExpiresAt은 미첨부 업로드 정리 시계, expiresAt은 첨부 후 보존 시계로 서로 대체하지 않는다(#115).
model SubmissionFile {
  id String @id @default(cuid())

  uploaderId    String
  uploader      User         @relation(fields: [uploaderId], references: [id])
  applicationId String?
  application   Application? @relation("SubmissionFileApplication", fields: [applicationId], references: [id], onDelete: Restrict)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int

  submissionRevisionId          String?
  submissionRevision            SubmissionRevision?          @relation(fields: [submissionRevisionId], references: [id])
  /// 마일스톤별 서류 항목(#619 확장) 제출에 첨부된 파일. 기존 submissionRevisionId 경로와는
  /// 독립적이다 — 한 SubmissionFile 행이 두 경로를 동시에 채우지 않는다.
  milestoneDocumentSubmissionId String?
  milestoneDocumentSubmission   MilestoneDocumentSubmission? @relation(fields: [milestoneDocumentSubmissionId], references: [id])
  lifecycle                     SubmissionFileLifecycle      @default(ATTACHED)
  pendingExpiresAt              DateTime?
  expiresAt                     DateTime?

  deleteClaimedAt      DateTime?
  deleteClaimExpiresAt DateTime?
  deleteClaimOwner     String?
  deleteAttemptCount   Int       @default(0)
  nextDeleteAttemptAt  DateTime?
  lastDeleteError      String?
  deletedAt            DateTime?

  createdAt DateTime @default(now())

  @@index([uploaderId])
  @@index([applicationId, milestoneId, lifecycle])
  @@index([lifecycle, pendingExpiresAt])
  @@index([lifecycle, nextDeleteAttemptAt, deleteClaimExpiresAt])
  @@index([submissionRevisionId])
  @@index([milestoneDocumentSubmissionId])
}

/// 마일스톤 하나가 요구하는 서류 항목 정의(#3 "프로젝트 계획서 제출" → 3개 항목 등).
/// 기존 Milestone.submissionType(마일스톤당 단일 제출 유형)과 Submission/SubmissionRevision은
/// 그대로 두고 이 모델이 항목 단위 확장을 더한다 — 서류가 없는 마일스톤은 documents가 비어 있다.
model MilestoneDocument {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  name           String
  required       Boolean
  sortOrder      Int
  /// 기존 Milestone.submissionType과 동일한 enum을 재사용한다.
  submissionType MilestoneSubmissionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateFile MilestoneDocumentTemplateFile?
  submissions  MilestoneDocumentSubmission[]

  @@index([milestoneId, sortOrder])
}

/// 교직원이 올린 서류 항목별 양식 파일. 항목당 "현재 양식" 한 건만 유지하는 upsert 모양이라
/// History 접미사를 쓰지 않는다 — "양식 교체"는 이 행을 덮어쓴다(#164 명명 규칙 §4).
model MilestoneDocumentTemplateFile {
  id                  String            @id @default(cuid())
  milestoneDocumentId String            @unique
  milestoneDocument   MilestoneDocument @relation(fields: [milestoneDocumentId], references: [id])

  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([uploadedById])
}

/// (서류 항목 × 신청/팀)당 제출 상태·시각. 행이 존재하지 않으면 "미제출"이다(status enum에
/// NOT_SUBMITTED를 두지 않는다 — DTO 계층이 없음을 'NOT_SUBMITTED' sentinel로 표현하는 기존
/// viewerSubmissionStatus 관례를 따른다). FILE 유형은 files로, TEXT 유형은 content Json으로
/// 응답을 담는다.
model MilestoneDocumentSubmission {
  id String @id @default(cuid())

  milestoneDocumentId String
  milestoneDocument   MilestoneDocument @relation(fields: [milestoneDocumentId], references: [id])

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  status  SubmissionStatus @default(SUBMITTED)
  content Json?

  /// 이 행이 몇 번째 제출인가 — 첫 제출이 1이고 재제출마다 `upsertSubmission`이 트랜잭션 안에서
  /// 1씩 올린다. 「교직원이 본 그 제출물인가」를 판정 요청이 이 값으로 되묻는다
  /// (`expectedRevision`).
  ///
  /// `submittedAt`으로는 그 질문에 답할 수 없다. 이 컬럼은 PostgreSQL `TIMESTAMP(3)`이라 같은
  /// 팀의 두 사람이(또는 한 사람의 재시도가) **같은 밀리초 안에** 다시 내면 값이 같아진다. 제출은
  /// upsert라 행 id도 그대로다. 그러면 기대값 대조가 통과하는데 내용은 바뀌어 있다 — 교직원이
  /// 보지 못한 내용이 승인된다. 리비전은 시계가 아니라 **쓰기 횟수**를 세므로 같은 밀리초의
  /// 재제출도 반드시 다른 값이 된다.
  ///
  /// `@default(1)`이 요점이다. Nullable이면 대조가 `null !== number`로 언제나 어긋나 판정이
  /// 전부 409가 되고, 기본값이 없으면 새 행의 시작값을 애플리케이션이 정하게 되어 경로마다
  /// 갈린다. 기존 행은 없으므로 백필이 필요 없다.
  revision Int @default(1)

  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files           SubmissionFile[]
  /// 판정 이력 — 제출 하나에 여러 건이 쌓인다(모델 주석 참고). 이름이 복수 목록인 것은
  /// 「지금의 판정」이 아니라 **이력 전체**가 여기 달리기 때문이다.
  reviewHistories MilestoneDocumentReviewHistory[]

  @@unique([milestoneDocumentId, applicationId])
  @@index([applicationId])
  @@index([submittedById])
}

/// 서류 제출물에 대한 교직원 판정(승인 · 보완 요청 · 반려). 제출 하나에 판정이 **여러 건 쌓인다**.
///
/// 이름이 `…History`로 끝나는 것은 그 모양 때문이다 — 시간 축(`reviewedAt`)이 전진할수록 행이
/// 늘고 지난 행을 지우지 않는다(docs/rules/data-modeling.md §4). 바로 위
/// `MilestoneDocumentTemplateFile`이 `History`를 **쓰지 않는** 것과 짝을 이룬다: 그쪽은 항목당
/// 한 행을 덮어쓰는 upsert 모양이다.
///
/// ⚠ 옛 `Review`는 `submissionRevisionId @unique`라 제출 revision 하나에 판정이 하나뿐이다
/// (재제출하면 revision이 새로 생겨 그쪽에 새 판정이 붙는다). 이 모델은 그 unique를 **일부러
/// 걸지 않는다** — 서류 제출은 revision을 쌓지 않고 `MilestoneDocumentSubmission` 한 행을
/// 덮어쓰는 upsert 모양이라, 판정에 unique를 걸면 재판정이 지난 판정을 **덮어쓴다**.
/// 그러면 「보완 요청 때 무엇을 지적받았는가」가 사라진다. 담당 교직원이 바뀌어도 지난 지적이
/// 남아 있어야 한다는 것이 이 기능의 요구라서, 판정은 갱신하지 않고 매번 새 행으로 append한다.
/// 「지금의 판정」은 이 이력의 최신 한 건이고, 그 결과를 `MilestoneDocumentSubmission.status`가
/// 반영한다.
///
/// `@@index([milestoneDocumentSubmissionId, reviewedAt])`가 그 「최신 한 건」 조회를 받친다
/// (수합 표는 제출마다 최신 판정을 한 건씩 끌어온다).
model MilestoneDocumentReviewHistory {
  id String @id @default(cuid())

  milestoneDocumentSubmissionId String
  milestoneDocumentSubmission   MilestoneDocumentSubmission @relation(fields: [milestoneDocumentSubmissionId], references: [id])

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  /// 기존 enum을 재사용한다 — 판정의 뜻이 제출물 검토와 같아서 새 enum을 만들지 않는다.
  decision   ReviewDecision
  comment    String?
  reviewedAt DateTime       @default(now())

  @@index([milestoneDocumentSubmissionId, reviewedAt])
  @@index([reviewerId])
}

/// 판정: APPROVED/REJECTED/CHANGES_REQUESTED. 제출 판정과 저장소 공개 전환 상태를 같은 필드로 합치지 않는다(#113).
enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model Review {
  id String @id @default(cuid())

  submissionRevisionId String             @unique
  submissionRevision   SubmissionRevision @relation(fields: [submissionRevisionId], references: [id])

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  decision   ReviewDecision
  comment    String?
  reviewedAt DateTime       @default(now())

  @@index([reviewerId])
}

/// 공개 범위(#113 상태 enum 계약).
enum RepositoryVisibility {
  PRIVATE
  PUBLIC
}

/// 공개 쿼리는 이 두 테이블만 조회한다(#126/#134); private 원본 join 금지.
/// todo 16 — ADR-003 공개 strict-read 예외 이후 신규 공개 read(`public-projects` 모듈)는
/// 이 규칙 대상이 아니다 — 전용 repository가 명시적 select로 `Repository` 원본을 직접 읽는다.
/// 이 두 테이블은 todo 20까지 유지되는 레거시 writer(`ShowcaseProjectionService`) 전용으로 남는다.
model PublicShowcaseRepository {
  repositoryId            String          @id
  githubRepositoryId      BigInt          @unique
  repositoryName          String
  repositoryUrl           String
  publishedAt             DateTime
  programId               String
  programName             String
  programCategory         ProgramCategory
  programEndAt            DateTime
  teamName                String?
  displayName             String
  approvedSubmissionCount Int
  projectedAt             DateTime        @updatedAt

  contributors PublicShowcaseContributor[]

  @@index([programId])
}

/// 공개 쿼리는 이 두 테이블만 조회한다(#126/#134); private 원본 join 금지.
model PublicShowcaseContributor {
  id             String                   @id @default(cuid())
  repositoryId   String
  repository     PublicShowcaseRepository @relation(fields: [repositoryId], references: [repositoryId], onDelete: Cascade)
  userId         String
  githubNickname String
  avatarUrl      String?

  @@unique([repositoryId, userId])
  @@index([userId])
}

enum RepositoryInvitationStatus {
  PENDING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
}

model RepositoryInvitation {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id])

  githubLogin String

  status              RepositoryInvitationStatus @default(PENDING)
  attemptCount        Int                        @default(0)
  reconciliationCount Int                        @default(0)

  lastErrorCode    String?
  lastErrorMessage String?
  processedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, githubLogin])
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/// idempotencyKey unique로 outbox 중복 처리를 방지한다. worker claim은 (status, availableAt) 인덱스를 사용한다(#113 계약).
model OutboxEvent {
  id String @id @default(cuid())

  type          String
  aggregateType String
  aggregateId   String

  idempotencyKey String @unique
  payload        Json

  status       OutboxEventStatus @default(PENDING)
  attemptCount Int               @default(0)
  availableAt  DateTime          @default(now())

  lockedAt DateTime?
  lockedBy String?

  processedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
}

enum RepositoryProvisionJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
}

/// application id당 최대 한 건. worker claim은 (status, nextAttemptAt) 인덱스를 사용한다(#113 계약).
model RepositoryProvisionJob {
  id String @id @default(cuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  repositoryId String?           @unique
  repository   GithubRepository? @relation(fields: [repositoryId], references: [id])

  status        RepositoryProvisionJobStatus @default(PENDING)
  attemptCount  Int                          @default(0)
  nextAttemptAt DateTime                     @default(now())

  lockedAt DateTime?
  lockedBy String?

  lastErrorCode    String?
  lastErrorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

/// outbox나 저장소 job을 Notification으로 대신 구현하지 않는다(#113 계약).
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type           String
  payload        Json
  channel        String
  status         String
  idempotencyKey String? @unique

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// outbox나 job을 AuditLog로 대신 구현하지 않는다(#113 계약).
model AuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  action     String
  targetType String
  targetId   String
  metadata   Json

  occurredAt DateTime @default(now())

  @@index([actorId])
}

enum CollectionTrigger {
  SELF
  BATCH
}

enum CollectionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  RATE_LIMITED
}

enum ObservationSourceType {
  PROFILE
  REPO
  EVENT
}

model CollectionRun {
  id               String                 @id @default(cuid())
  targetGithubId   BigInt
  targetLogin      String
  trigger          CollectionTrigger
  status           CollectionRunStatus
  profileCount     Int                    @default(0)
  repoCount        Int                    @default(0)
  eventCount       Int                    @default(0)
  retryNotBeforeAt DateTime?
  startedAt        DateTime               @default(now())
  finishedAt       DateTime?
  observations     GithubRawObservation[]
}

model GithubRawObservation {
  id         String                @id @default(cuid())
  runId      String
  run        CollectionRun         @relation(fields: [runId], references: [id])
  sourceType ObservationSourceType
  sourceId   String
  payload    Json
  fetchedAt  DateTime              @default(now())

  @@unique([runId, sourceType, sourceId])
}

enum CollectionRepositoryPresence {
  PRESENT
  ABSENT
}

/// GithubRepository 통합 설계(.omc/plans/github-repository-unification.md §5)의 source 축 —
/// 별도 테이블이 아니라 이 컬럼으로 수집 방법 차이를 표현한다.
enum RepositorySource {
  ORG_PROVISIONED
  EXTERNAL_PUBLIC
}

/// ADR-006 조직 전체 누적·증분 수집의 논리 저장소 identity. App installation 교체와 무관하게
/// githubRepositoryId(GitHub 전역 고유)로 유일하다 — installation id는 identity에 포함하지 않는다.
/// visibility/presence는 complete inventory 관찰에서만 갱신된다(DEC-46, fail-closed 공개 회수).
/// 단계 C(github-repository-unification §7) 개명 — 구 CollectionRepository. githubOrganizationId는
/// EXTERNAL_PUBLIC 저장소가 조직 소속이 아니므로 nullable이다(R4).
/// 단계 D(#617) — 구 Repository(#449 프로비저닝 산출물) 테이블을 흡수했다. name/url 컬럼은 두지
/// 않는다 — nameWithOwner에서 파생한다(github 모듈의 공유 helper). application/program/team 연결은
/// ORG_PROVISIONED 흐름에서만 채워지며(4개 컬럼 모두 nullable), 인벤토리 스윕 upsert
/// (recordRepositoryObservation)는 이 4개 컬럼을 절대 건드리지 않는다.
model GithubRepository {
  id String @id @default(cuid())

  githubOrganizationId BigInt?
  githubRepositoryId   BigInt  @unique

  nameWithOwner String
  defaultBranch String?
  archived      Boolean @default(false)

  source RepositorySource

  visibility RepositoryVisibility         @default(PRIVATE)
  presence   CollectionRepositoryPresence @default(PRESENT)

  lastCompleteInventoryObservedAt DateTime?

  /// 수집 편입 큐. 행이 존재한다는 것이 곧 "이 저장소는 수집 대상"이라는 뜻이며,
  /// 별도의 편입 단계나 조건절을 두지 않는다(ADR-010 §6). 프로비저닝이 `NEW` 생성이든
  /// `OWN` 연결이든 행을 만드는 순간 `nextRunAt` 기본값 `now()`로 큐에 들어간다.
  nextRunAt     DateTime  @default(now())
  /// 마지막으로 이 저장소 수집이 끝까지 성공한 시각. 건강 지표의 신선도 축이다.
  lastSuccessAt DateTime?
  /// 연속 실패 횟수. 백오프와 격리 판정의 입력이며 성공 시 0으로 되돌린다.
  failureCount  Int       @default(0)

  /// #617 단계 D — application id당 최대 한 건. 모든 신청이 Team을 갖더라도(1인 팀 포함, D5)
  /// 저장소 식별 단위는 application이다 — programId+teamId unique로 식별하지 않는다(#113).
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Restrict)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams       CollectionRepositoryStream[]
  commits       CollectionCommitFact[]
  pullRequests  CollectionPullRequestFact[]
  releases      CollectionReleaseFact[]
  contributions Contribution[]
  invitations   RepositoryInvitation[]
  provisionJob  RepositoryProvisionJob?

  @@index([source, visibility])
  @@index([visibility, presence])
  /// 큐에서 "가장 오래 굶은 것부터" 꺼내는 정렬을 인덱스가 받친다.
  @@index([nextRunAt])
  @@index([programId])
  @@index([teamId])
  /// todo 16 — `GET /projects` 목록 커서 페이지네이션(publishedAt desc, id desc)이 이 인덱스를 쓴다.
  @@index([visibility, publishedAt, id])
}

/// 기여 추적의 유일한 사실 테이블 (ADR-010 §4).
///
/// 한 행 = "이 저장소에서 이 사람이 이 날 남긴 기여".
/// grain 을 이름에 넣지 않는다 — grain 이 바뀌면 이름이 거짓말이 되기 때문이며,
/// 앞선 `*YearAggregate` 가 정확히 그 실패를 겪었다.
///
/// **저장에 연도 개념이 없다.** 읽을 때 `WHERE date` 범위로만 자르므로 새해에
/// 롤오버 작업도, 당해 연도를 0으로 초기화하는 특수 처리도 필요 없다.
/// 연도로 접으면 랭킹이, 저장소로 접으면 팀 기여도가 같은 바닥에서 나온다.
///
/// 집계 수치만 담는다. 커밋 메시지·PR 제목/본문·릴리스 본문은 저장하지 않으며,
/// 개별 식별자(`sha`·PR id·릴리스 id)도 보존하지 않는다 —
/// "무엇을 했는지"가 아니라 "얼마나 했는지"만 남는다(ADR-006 저장 field inventory).
model Contribution {
  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  /// 학생의 GitHub 숫자 id. `User.githubId` 와 같은 값이며 NOT NULL 이다 —
  /// 귀속을 특정할 수 없는 기여는 애초에 적재하지 않는다(ADR-010 §5).
  githubId BigInt

  /// Asia/Seoul 기준 날짜. 날짜 경계 해석은 쓰기 시점이 아니라 이 칸의 정의에만 있다.
  date DateTime @db.Date

  commitCount      Int @default(0)
  pullRequestCount Int @default(0)
  releaseCount     Int @default(0)

  updatedAt DateTime @updatedAt

  /// grain 은 이름이 아니라 기본키가 정의한다.
  @@id([repositoryId, githubId, date])
  /// 두 축을 각각 받친다.
  /// 저장소 축(② 팀 기여도)은 기본키 선두가 커버하고,
  /// 사람 축(랭킹·프로필 등 `githubId` 시작 조회)은 아래 인덱스가 받는다.
  @@index([githubId, date])
  @@index([date])
}

/// 사람 축 활동 이력 (data-modeling.md §2 `user ↔ yearly activity history`).
///
/// 한 행 = "이 GitHub 계정이 이 해에 얼마나 활동했는가". `Contribution`(저장소 축)과
/// 답하는 질문이 다르다 — 저장소 축은 "우리 저장소에서 무엇이 일어났는가"를 세고,
/// 이 테이블은 저장소를 거치지 않고 그 사람의 한 해 활동 전체를 GitHub에게 직접 묻는다.
/// 키가 다르므로(`repositoryId` 없음) 한 테이블로 합칠 수 없다(§2 — PK 컬럼 NULL 불가).
///
/// **연도 축으로 행이 쌓인다.** 지난 연도 행을 지우지 않고 새 연도 행이 늘어나므로
/// 이름이 `History`로 끝난다(§4 · `LoginHistory` 선례). 당해 연도 행은 관측할 때마다
/// 전량 재계산으로 덮어쓰고, 지난 연도 행은 그대로 둔다.
///
/// **`User` FK를 걸지 않는다**(§3). `githubId` 값으로 키를 잡고 `githubLogin`만
/// 비정규화해 행 하나로 공개 표시가 끝나게 한다 — 아직 가입하지 않은 사람이 조용히
/// 사라지지 않고, 공개 응답이 private 원본과 join할 구조적 여지도 생기지 않는다.
/// 실명(`User.name`)·학과는 담지 않는다 — 조회 시점에 join해서 붙인다.
///
/// 관측값만 담는다. 순위는 저장하지 않고 조회 시점에 계산한다(ADR-010 §4).
/// `starCount`는 그 계정 공개 저장소의 **누적** star다 — GitHub이 연도별 분해를 주지 않는다.
model GithubUserActivityHistory {
  /// GitHub 숫자 id. `User.githubId`와 같은 값이지만 FK가 아니다 — 값으로만 잇는다.
  githubId    BigInt
  /// 표시용 비정규화 값. 이 테이블은 관측마다 전량 덮어쓰므로 drift가 남지 않는다(§3).
  githubLogin String
  /// Asia/Seoul 경계로 자른 관측 연도. 연도 창 해석은 쓰기 시점이 아니라 이 칸의 정의에만 있다.
  year        Int

  commitCount      Int @default(0)
  pullRequestCount Int @default(0)
  issueCount       Int @default(0)
  repositoryCount  Int @default(0)
  starCount        Int @default(0)

  /// 이 행을 만든 관측 시각. 화면의 `dataAsOf`와 수집 신선도 판정이 이 칸을 읽는다.
  observedAt DateTime

  /// grain 은 이름이 아니라 기본키가 정의한다 — 사람 1명 × 연도 1개 = 1행.
  @@id([githubId, year])
  /// 랭킹은 언제나 연도로 먼저 자른다.
  @@index([year])
}

enum CollectionStreamType {
  COMMIT
  PULL_REQUEST
  RELEASE
}

enum CollectionStreamStatus {
  PENDING
  BACKFILLING
  READY
  VERIFYING
}

/// stream(commit/PR/release)별 safe frontier + exact-request fingerprint/ETag를 보존해
/// 재순회 없이 다음 증분 수집 시작점을 복원한다(ADR-006).
model CollectionRepositoryStream {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  streamType CollectionStreamType
  status     CollectionStreamStatus @default(PENDING)

  frontierSha       String?
  frontierCreatedAt DateTime?
  frontierEntityId  BigInt?

  requestFingerprint String?
  etag               String?

  lastRunAt     DateTime?
  lastErrorAt   DateTime?
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, streamType])
  @@index([status])
}

/// commit fact = (repositoryId, sha) + committedAt만 보존한다 — message/author-email/diff는 저장하지 않는다(ADR-006).
model CollectionCommitFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  sha         String
  committedAt DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@index([authorGithubId])
}

/// PR fact = (repositoryId, githubPullRequestId) + observedAt만 보존한다 — title/body는 저장하지 않는다(ADR-006).
model CollectionPullRequestFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubPullRequestId BigInt
  state               String
  createdAt           DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, githubPullRequestId])
  @@index([repositoryId, createdAt])
  @@index([authorGithubId])
}

/// release fact = (repositoryId, githubReleaseId) + publishedAt만 보존한다 — body는 저장하지 않는다(ADR-006).
model CollectionReleaseFact {
  id String @id @default(cuid())

  repositoryId String
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubReleaseId BigInt
  publishedAt     DateTime

  authorGithubId    BigInt?
  authorGithubLogin String?

  observedAt DateTime @default(now())

  @@unique([repositoryId, githubReleaseId])
  @@index([repositoryId, publishedAt])
  @@index([authorGithubId])
}

/// installation 재순회의 fair 연속 커서 — org 전체를 한 번에 처리하지 않고 rate-limit 인지 상태로
/// 다음 저장소부터 이어간다(ADR-006). appId+scope는 프로세스 키일 뿐 논리 저장소 identity에는 포함하지 않는다.
/// scope는 단계 C(github-repository-unification §3.1) 일반화 — org sweep은 "org:<login>", 외부 sweep은
/// "external"을 쓴다. 두 sweep이 서로 다른 리스·커서를 가져 예산을 다투지 않게 하기 위함이다(GR-9).
model CollectionSyncCursor {
  appId BigInt
  scope String

  lastGithubRepositoryId BigInt?
  cycleStartedAt         DateTime?
  cycleCompletedAt       DateTime?

  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

/// todo 10 sync orchestration의 epoch-fenced 상호배제 lease. `CanonicalCollectionLease`와 같은
/// 패턴(epoch 증가 + expiresAt fencing)을 쓰되, 별도 run 후보 테이블 없이 lease 자체가 "진행 중인
/// run"을 나타낸다 — 진행 bookkeeping인 `CollectionSyncCursor`와는 별개 관심사로 분리한다(ADR-006).
/// scope 규약은 `CollectionSyncCursor`와 동일(§3.1) — org sweep과 외부 sweep이 서로 다른 리스를 잡는다.
model CollectionSyncLease {
  appId     BigInt
  scope     String
  epoch     BigInt   @default(1)
  ownerId   String
  runId     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

/// todo 14 원자 전환(atomic reader/writer cutover) 절차 전용 quiesce lease. `CollectionSyncLease`와
/// 같은 epoch-fenced 패턴이다 — lease 보유 자체가 "cutover 진행 중"을 나타내며, 이 창(window) 동안
/// 스케줄러/관리자 트리거는 명시적으로 거부된다(silent skip이 아니라 별도 에러 코드로 reject한다).
/// 절차 완료(성공/abort 무관) 시 항상 해제해 트리거가 재개되도록 한다(ADR-006).
/// scope 규약은 `CollectionSyncCursor`와 동일(§3.1).
model CollectionCutoverLease {
  appId     BigInt
  scope     String
  epoch     BigInt   @default(1)
  ownerId   String
  runId     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([appId, scope])
}

/// 시스템 상태 관측성 2단계 — sweep 1회(예산 중단으로 사이클을 여러 sweep에 걸쳐 나눠 처리할 수 있어
/// 사이클이 아니라 sweep이 행 단위다) 종료 시점의 활동 이력을 append-only로 남긴다. `data-modeling.md`
/// §4의 두 모델링 축(user↔repository, repository↔history) 중 어디에도 정확히 들어맞지 않지만,
/// `CollectionSyncCursor`(같은 appId+scope 프로세스 키, 같은 운영 bookkeeping 목적)가 이미 그 축 밖에서
/// 인정된 선례라 같은 예외로 취급한다. repository 이름은 담지 않는다(집계 전용 — `collection-read.port.ts`
/// 경계 코멘트 참고).
model CollectionSweepHistory {
  id String @id @default(cuid())

  appId BigInt
  scope String

  sweepFinishedAt DateTime
  cycleStartedAt  DateTime?

  insertedCommitCount      Int
  insertedPullRequestCount Int
  insertedReleaseCount     Int

  attemptedRepositoryCount Int
  processedRepositoryCount Int
  failedRepositoryCount    Int

  cycleCompleted   Boolean
  stoppedForBudget Boolean

  @@index([sweepFinishedAt])
}
