<button type="button" class="theme-toggle" aria-label="화면 테마 전환">
  <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path></svg>
</button>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('.theme-toggle')) return;
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('starlight-theme', next);
    } catch {}
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--guide-line);
    border-radius: 0.6rem;
    background: none;
    color: var(--sl-color-gray-1);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--sl-color-gray-6);
  }
  .i-sun {
    display: none;
  }
  :global(html[data-theme='dark']) .i-sun {
    display: block;
  }
  :global(html[data-theme='dark']) .i-moon {
    display: none;
  }
</style>
