---
import { isEnglishGuide } from './locale';
interface Props {
  title?: string;
}
const english = isEnglishGuide(Astro.url);
const { title = english ? 'Success signal' : '성공 신호' } = Astro.props;
---

<aside class="callout success" aria-label={title}>
  <p class="callout-title">{title}</p>
  <div class="callout-body"><slot /></div>
</aside>
