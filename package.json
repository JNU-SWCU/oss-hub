{
  "name": "oss-hub",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && pnpm lint:structure",
    "lint:structure": "knip && pnpm lint:scripts",
    "lint:scripts": "apps/backend/node_modules/.bin/eslint --max-warnings=0 --config scripts/eslint.config.mjs scripts/check-file-ledger.ts scripts/eslint.config.mjs",
    "check:file-ledger": "node scripts/check-file-ledger.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "commitlint": "commitlint --config commitlint.config.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "bash dev.sh",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:migrate:dev": "pnpm --filter backend db:migrate:dev",
    "db:reset": "pnpm --filter backend db:reset",
    "db:seed": "pnpm --filter backend db:seed",
    "postinstall": "pnpm --filter backend exec prisma generate"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "knip": "6.40.0",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.63.0"
  }
}
