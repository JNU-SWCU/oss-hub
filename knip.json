{
  "$schema": "https://unpkg.com/knip@6.40.0/schema.json",
  "include": [
    "files",
    "exports",
    "types",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries"
  ],
  "ignore": [".gjc/**"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.test.mjs",
        "scripts/jenkins/probe-release-state.mjs",
        "scripts/member-authority-contract-seed.mjs",
        "eslint.shared.mjs",
        "eslint-rules/no-comments.mjs",
        ".design-sync/compile-css.mjs",
        ".design-sync/emit-types.mjs",
        ".design-sync/previews/*.tsx"
      ],
      "project": ["**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"],
      "ignoreDependencies": ["@prisma/client"],
      "paths": {
        "frontend": ["./apps/frontend/src/components/index.ts"]
      }
    },
    "apps/backend": {
      "entry": [
        "src/main.ts",
        "test/e2e-program-authoring/main.ts",
        "prisma/seed.ts",
        "{src,test,prisma}/**/*.spec.ts"
      ],
      "project": [
        "{src,test,prisma}/**/*.ts",
        "*.{js,mjs,cjs,ts}",
        "{scripts,eslint-rules}/**/*.{js,mjs,cjs,ts}"
      ],
      "includeEntryExports": true
    },
    "apps/frontend": {
      "tailwind": {
        "entry": ["src/app/globals.css"]
      },
      "entry": [
        "src/middleware.ts",
        "next.config.ts",
        "{src,test-support,e2e/support}/**/*.test.{ts,tsx}",
        "e2e/**/*.spec.ts"
      ],
      "project": [
        "{src,e2e,test-support,scripts}/**/*.{js,mjs,cjs,ts,tsx}",
        "*.{js,mjs,cjs,ts,mts}"
      ],
      "ignoreDependencies": ["pretendard", "@prisma/client"],
      "paths": {
        "server-only": [
          "./node_modules/next/dist/compiled/server-only/index.js"
        ]
      }
    }
  }
}
